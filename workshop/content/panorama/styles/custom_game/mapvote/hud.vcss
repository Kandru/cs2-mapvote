/* MapVote HUD — port of CS2 end-of-match vote styles (ruleset-safe).
   Sources: stuff/panorama/styles/endofmatch-voting.css
            stuff/panorama/styles/endofmatch.css
            stuff/panorama/styles/mainmenu_play.css (.map-selection-btn*)
   Layout extras (50 maps, scroll, voted strip) keep Valve tile metrics. */

.HudScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

.VoteRoot
{
	width: 100%;
	height: 100%;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

.VoteRoot.is-fading
{
	opacity: 0.0;
	transition-duration: 0.18s;
	transition-timing-function: ease-in;
}

.VoteRoot.is-off
{
	visibility: collapse;
}

/* Light frost (~5%) — darkening comes from Valve .eom / .eom-layout scrims below. */
.mv-glass
{
	width: 100%;
	height: 100%;
	background-color: #0000000d;
	world-blur: gaussian( 1 );
	ignore-parent-flow: true;
}

/* .eom-layout */
.mv-scrim-top
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000e0 ), to( #00000000 ) );
	ignore-parent-flow: true;
}

/* .eom */
.mv-scrim-bottom
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 100%, 0% 0%, from( #000000a0 ), color-stop( 0.5, #00000000 ), to( #00000000 ) );
	ignore-parent-flow: true;
}

.VoteColumn
{
	width: 100%;
	height: 100%;
	flow-children: down;
}

/* Top chrome: title centered in the old spacer band, minimize top-right. */
.VoteTopBar
{
	width: 100%;
	height: 48px;
	flow-children: none;
}

/* Valve directive: stratum-regular-condensed + fontSize-l (20). */
.VoteTitle
{
	width: 100%;
	height: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Condensed;
	font-weight: normal;
	font-size: 20;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #ffffff;
}

/* CS2-ish chip: toggles the vote stage; stays visible when minimized. */
.MinimizeBtn
{
	width: 108px;
	height: 32px;
	horizontal-align: right;
	vertical-align: middle;
	margin-right: 16px;
	background-color: #00000099;
	border: 1px solid #ffffff33;
	border-radius: 3px;
	flow-children: none;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-in-out;
}

.MinimizeBtn:hover
{
	background-color: #ffffff22;
	brightness: 1.1;
	sound: "UIPanorama.generic_button_rollover";
}

.MinimizeBtn:active
{
	brightness: 0.85;
	sound: "UIPanorama.generic_button_press";
}

/* Button label: width 100%, vertical-align middle, no height 100% (ruleset §5.3). */
.MinimizeLabel
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 14;
	letter-spacing: 1.2px;
	text-transform: uppercase;
	color: #ffffff;
	white-space: nowrap;
}

.VoteRoot.is-minimized .mv-glass,
.VoteRoot.is-minimized .mv-scrim-top,
.VoteRoot.is-minimized .mv-scrim-bottom,
.VoteRoot.is-minimized .VoteBody,
.VoteRoot.is-minimized .VoteTitle
{
	visibility: collapse;
}

.VoteRoot.is-minimized .MinimizeBtn
{
	background-color: #000000cc;
	border: 1px solid #ff9a1a;
}

.VoteRoot.is-minimized .MinimizeLabel
{
	color: #ff9a1a;
}

/* Full-bleed stage — scrollbar on screen edge; cards centered. */
.VoteBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	/* #id-map-selection-container margin-top: 12px */
	padding-top: 12px;
}

/* Leading / voted strip — always present (CS2 vote stage energy). */
.VotedSection
{
	width: 100%;
	flow-children: down;
	padding-top: 8px;
	padding-bottom: 12px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000b3 ), to( #00000066 ) );
	border-bottom: 1px solid #ffffff22;
}

.VotedSection.has-votes
{
	border-bottom: 2px solid #ff9a1a;
}

.VotedRow
{
	width: 100%;
	height: 213px;
	/* Horizontal strip only — never a vertical scrollbar. */
	overflow: scroll clip;
	flow-children: none;
	horizontal-align: center;
}

.VotedHint
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Condensed;
	font-weight: normal;
	font-size: 14;
	color: #a3acb6;
	letter-spacing: 1px;
	text-transform: uppercase;
	ignore-parent-flow: true;
	z-index: 1;
}

.VotedHint.is-off
{
	visibility: collapse;
}

.VotedStrip
{
	height: 213px;
	flow-children: right;
	overflow: noclip noclip;
	horizontal-align: center;
	vertical-align: middle;
}

/* Slot pitch = 110px tile + 8px + 8px margin = 126px */
.VotedStrip.vw-0 { width: 0px; }
.VotedStrip.vw-1 { width: 126px; }
.VotedStrip.vw-2 { width: 252px; }
.VotedStrip.vw-3 { width: 378px; }
.VotedStrip.vw-4 { width: 504px; }
.VotedStrip.vw-5 { width: 630px; }
.VotedStrip.vw-6 { width: 756px; }
.VotedStrip.vw-7 { width: 882px; }
.VotedStrip.vw-8 { width: 1008px; }
.VotedStrip.vw-9 { width: 1134px; }
.VotedStrip.vw-10 { width: 1260px; }
.VotedStrip.vw-11 { width: 1386px; }
.VotedStrip.vw-12 { width: 1512px; }
.VotedStrip.vw-13 { width: 1638px; }
.VotedStrip.vw-14 { width: 1764px; }
.VotedStrip.vw-15 { width: 1890px; }
.VotedStrip.vw-16 { width: 2016px; }
.VotedStrip.vw-17 { width: 2142px; }
.VotedStrip.vw-18 { width: 2268px; }
.VotedStrip.vw-19 { width: 2394px; }
.VotedStrip.vw-20 { width: 2520px; }
.VotedStrip.vw-21 { width: 2646px; }
.VotedStrip.vw-22 { width: 2772px; }
.VotedStrip.vw-23 { width: 2898px; }
.VotedStrip.vw-24 { width: 3024px; }
.VotedStrip.vw-25 { width: 3150px; }
.VotedStrip.vw-26 { width: 3276px; }
.VotedStrip.vw-27 { width: 3402px; }
.VotedStrip.vw-28 { width: 3528px; }
.VotedStrip.vw-29 { width: 3654px; }
.VotedStrip.vw-30 { width: 3780px; }
.VotedStrip.vw-31 { width: 3906px; }
.VotedStrip.vw-32 { width: 4032px; }
.VotedStrip.vw-33 { width: 4158px; }
.VotedStrip.vw-34 { width: 4284px; }
.VotedStrip.vw-35 { width: 4410px; }
.VotedStrip.vw-36 { width: 4536px; }
.VotedStrip.vw-37 { width: 4662px; }
.VotedStrip.vw-38 { width: 4788px; }
.VotedStrip.vw-39 { width: 4914px; }
.VotedStrip.vw-40 { width: 5040px; }
.VotedStrip.vw-41 { width: 5166px; }
.VotedStrip.vw-42 { width: 5292px; }
.VotedStrip.vw-43 { width: 5418px; }
.VotedStrip.vw-44 { width: 5544px; }
.VotedStrip.vw-45 { width: 5670px; }
.VotedStrip.vw-46 { width: 5796px; }
.VotedStrip.vw-47 { width: 5922px; }
.VotedStrip.vw-48 { width: 6048px; }
.VotedStrip.vw-49 { width: 6174px; }
.VotedStrip.vw-50 { width: 6300px; }

/* Catalog host: full-width scroll + soft edge fades (no hard clip). */
.MapGridHost
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: none;
}

.MapGrid
{
	width: 100%;
	height: 100%;
	overflow: squish scroll;
}

.MapGridFadeTop
{
	width: 100%;
	height: 64px;
	vertical-align: top;
	ignore-parent-flow: true;
	z-index: 5;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000f2 ), color-stop( 0.45, #00000099 ), to( #00000000 ) );
}

.MapGridFadeBottom
{
	width: 100%;
	height: 48px;
	vertical-align: bottom;
	ignore-parent-flow: true;
	z-index: 5;
	background-color: gradient( linear, 0% 100%, 0% 0%, from( #000000e6 ), color-stop( 0.5, #00000066 ), to( #00000000 ) );
}

.MapCatalog
{
	/* Full stage width — tiles flex so every aspect fills edge-to-edge (no side bars). */
	width: 100%;
	flow-children: down;
	overflow: noclip noclip;
	horizontal-align: center;
	padding-left: 12px;
	padding-right: 12px;
}

.MapCatalog.rows-0 { height: 0px; }
.MapCatalog.rows-1 { height: 213px; }
.MapCatalog.rows-2 { height: 426px; }
.MapCatalog.rows-3 { height: 639px; }
.MapCatalog.rows-4 { height: 852px; }
.MapCatalog.rows-5 { height: 1065px; }

.CatalogRow
{
	width: 100%;
	height: 213px;
	flow-children: right;
	horizontal-align: center;
}

.CatalogRow.is-off
{
	visibility: collapse;
}

/* ---- .map-selection-btn + .map-selection-btn--vote ---- */
.MapTile
{
	/* Voted strip keeps Valve 110×193; catalog overrides width below. */
	width: 110px;
	height: 193px;
	horizontal-align: center;
	margin: 10px 8px 10px 8px;
	/* base .map-selection-btn border, then --vote clears shadow */
	border: 0px solid #cacaca1a;
	box-shadow: none;
	wash-color: none;
	overflow: clip;
	flow-children: none;
	/* base transition (box-shadow omitted — ruleset) */
	transition-property: border, brightness, opacity;
	transition-duration: 0.25s;
	transition-timing-function: ease-in-out;
}

/* 10-across catalog: equal share of the full row at any resolution / aspect. */
.CatalogRow .MapTile
{
	width: fill-parent-flow( 1.0 );
}

.MapTile.is-off
{
	visibility: collapse;
}

/* .map-selection-btn--vote:selected */
.MapTile.is-self
{
	border: 2px solid #ffffff;
	box-shadow: #ffffff 0px 0px 6px 0px;
}

/* .map-selection-btn--vote--rndm — non-winners darken when the vote locks. */
.MapTile.is-lost
{
	wash-color: #000000;
	brightness: 0.55;
	border: 0px solid #cacaca1a;
	box-shadow: none;
	transition-property: wash-color, brightness, border, opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-in-out;
}

.MapTile:hover
{
	sound: "UIPanorama.submenu_contents_rollover";
}

.MapTile:active
{
	sound: "UIPanorama.submenu_select";
}

.MapTile.is-lost:hover .MapShot,
.MapTile.is-done:hover .MapShot
{
	transform: scale3d( 1.0, 1.0, 1.0 );
}

/* .map-selection-btn__screenshot — 16:9 at tile height, centered; sides crop as width flexes. */
.MapShot
{
	width: 100%;
	height: 100%;
	z-index: 0;
	ignore-parent-flow: true;
	transform: scale3d( 1.0, 1.0, 1.0 );
	background-repeat: no-repeat;
	background-size: 343px 193px;
	background-position: 50% 50%;
	transition-property: transform, opacity;
	transition-duration: 0.25s, 2.0s;
	transition-timing-function: ease-in-out;
}

/* endofmatch-voting: Hover screenshot → 1.2 */
.MapTile:hover .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

/* play: selected screenshot → 1.2 */
.MapTile.is-self .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

/* Shadow mask on top of the shot (Valve .map-selection-btn__gradient).
   Soft at the top, hard black at the bottom so name + count stay readable. */
.MapFade
{
	width: 100%;
	height: 100%;
	z-index: 1;
	ignore-parent-flow: true;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #00000000 ), color-stop( 0.35, #00000040 ), color-stop( 0.65, #000000cc ), to( #000000ff ) );
}

/* Label.map-selection-item-count — Stratum2 bold 26; amber from CS2 HTML count. */
.MapVotes
{
	width: 100%;
	z-index: 2;
	ignore-parent-flow: true;
	vertical-align: bottom;
	horizontal-align: center;
	margin: 0px;
	margin-bottom: 40px;
	font-family: Stratum2;
	font-weight: bold;
	font-size: 26;
	color: #ff9a1a;
	text-align: center;
}

/* MapGroupName: stratum-medium-condensed; --vote Label size 16. */
.MapName
{
	width: 90%;
	height: 36px;
	z-index: 2;
	ignore-parent-flow: true;
	margin: 0px 4px 0px 4px;
	vertical-align: bottom;
	horizontal-align: center;
	text-align: center;
	font-family: Stratum2 Medium Condensed;
	font-size: 16;
	color: #ffffff;
	text-overflow: ellipsis;
	white-space: nowrap;
}

/* Valve pulse-random (map-selection-btn__gradient--whiteout) — winner flash. */
@keyframes 'mv-winner-pulse'
{
	0%
	{
		border: 2px solid #ffffff00;
	}

	50%
	{
		border: 5px solid #ffff00;
	}

	100%
	{
		border: 2px solid #ffffff;
	}
}

/* Winner tile = selected chrome + one-shot yellow pulse, then white border. */
.MapTile.is-done
{
	wash-color: none;
	brightness: 1.0;
	border: 2px solid #ffffff;
	box-shadow: #ffffff 0px 0px 6px 0px;
	animation-name: 'mv-winner-pulse';
	animation-duration: 0.5s;
	animation-timing-function: ease-in-out;
	animation-iteration-count: 1;
}

/* Winner shot stays zoomed like :selected. */
.MapTile.is-done .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

/* #id-map-selection-btn__winner — resting (hidden, scaled up). */
.MapWinnerCheck
{
	width: 50px;
	height: 50px;
	z-index: 3;
	ignore-parent-flow: true;
	vertical-align: middle;
	horizontal-align: center;
	background-image: url( "s2r://panorama/images/icons/ui/vote_check.vsvg" );
	background-size: 50px 50px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	wash-color: #2bff00;
	opacity: 0.0;
	transform: scale3d( 2.0, 2.0, 1.0 );
	transition-property: transform, opacity;
	transition-duration: 0.1s;
	transition-timing-function: ease-in-out;
}

@keyframes 'mv-check-appear'
{
	0%
	{
		opacity: 0.0;
		transform: scale3d( 2.0, 2.0, 1.0 );
	}

	100%
	{
		opacity: 1.0;
		transform: scale3d( 1.0, 1.0, 1.0 );
	}
}

/* #id-map-selection-btn__winner.appear */
.MapTile.is-done .MapWinnerCheck
{
	opacity: 1.0;
	transform: scale3d( 1.0, 1.0, 1.0 );
	animation-name: 'mv-check-appear';
	animation-duration: 0.1s;
	animation-timing-function: ease-in-out;
	animation-iteration-count: 1;
	animation-delay: 0.35s;
	animation-fill-mode: backwards;
}

/* BEGIN mv-map-palette */
/* Map screenshots — class names must stay ASCII-safe for CustomHud.SetHasClass.
   `make images` rewrites this block from extracted PNGs. */
.mv-map-default { background-image: url( "s2r://panorama/images/custom_game/mapvote/maps/default.vtex" ); }
/* END mv-map-palette */
