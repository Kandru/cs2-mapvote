/* MapVote HUD — CS2 end-of-match vote (ruleset-safe).
   Contract: vote.xml / VoteIds.cs  Palette: surface #12171ee8→#0b0f14f2, accent #ff9a1a
   Deviation: background-position 50% 50% on .MapShot only — centers the 343×193 cover crop (§5.1). */

.HudScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

.VoteRoot
{
	width: 100%;
	height: 100%;
	flow-children: none;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

.VoteRoot.is-fading
{
	opacity: 0.0;
	transition-duration: 0.18s;
	transition-timing-function: ease-in;
}

.VoteRoot.is-off
{
	visibility: collapse;
}

.mv-glass
{
	width: 100%;
	height: 100%;
	background-color: #0000000d;
	world-blur: gaussian( 1 );
}

.mv-scrim-top
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000e0 ), to( #00000000 ) );
}

.mv-scrim-bottom
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 100%, 0% 0%, from( #000000a0 ), color-stop( 0.5, #00000000 ), to( #00000000 ) );
}

.VoteColumn
{
	width: 100%;
	height: 100%;
	flow-children: down;
}

.VoteTopBar
{
	width: 100%;
	height: 40px;
	flow-children: none;
}

.VoteTitle
{
	width: 100%;
	height: 28px;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 20;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #ffffff;
}

.MinimizeBtn
{
	width: 108px;
	height: 28px;
	horizontal-align: right;
	vertical-align: middle;
	margin-right: 16px;
	background-color: #00000099;
	border: 1px solid #ffffff33;
	border-radius: 3px;
	flow-children: none;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.MinimizeBtn:hover
{
	background-color: #ffffff22;
	brightness: 1.1;
	sound: "UIPanorama.generic_button_rollover";
}

.MinimizeBtn:active
{
	brightness: 0.85;
	sound: "UIPanorama.generic_button_press";
}

.MinimizeLabel
{
	width: 100%;
	height: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 14;
	letter-spacing: 1.2px;
	text-transform: uppercase;
	color: #ffffff;
	white-space: nowrap;
}

.VoteRoot.is-minimized .mv-glass,
.VoteRoot.is-minimized .mv-scrim-top,
.VoteRoot.is-minimized .mv-scrim-bottom,
.VoteRoot.is-minimized .VoteBody,
.VoteRoot.is-minimized .VoteTitle,
.VoteRoot.is-minimized .CreditBar
{
	visibility: collapse;
}

.VoteRoot.is-minimized .MinimizeBtn
{
	background-color: #000000cc;
	border: 1px solid #ff9a1a;
}

.VoteRoot.is-minimized .MinimizeLabel
{
	color: #ff9a1a;
}

.VoteBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	padding-top: 12px;
}

.VotedSection
{
	width: 100%;
	flow-children: down;
	padding-top: 8px;
	padding-bottom: 12px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000b3 ), to( #00000066 ) );
	border-bottom: 1px solid #ffffff14;
}

.VotedSection.has-votes
{
	border-bottom: 2px solid #ff9a1a;
}

.VotedRow
{
	width: 100%;
	height: 213px;
	overflow: scroll clip;
	flow-children: none;
	horizontal-align: center;
}

.VotedHint
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 14;
	color: #a3acb6;
	letter-spacing: 1px;
	text-transform: uppercase;
	z-index: 1;
}

.VotedHint.is-off
{
	visibility: collapse;
}

.VotedStrip
{
	height: 213px;
	flow-children: right;
	overflow: noclip noclip;
	horizontal-align: center;
	vertical-align: middle;
}

/* Slot pitch = 110px tile + 8px + 8px margin = 126px */
.VotedStrip.vw-0 { width: 0px; }
.VotedStrip.vw-1 { width: 126px; }
.VotedStrip.vw-2 { width: 252px; }
.VotedStrip.vw-3 { width: 378px; }
.VotedStrip.vw-4 { width: 504px; }
.VotedStrip.vw-5 { width: 630px; }
.VotedStrip.vw-6 { width: 756px; }
.VotedStrip.vw-7 { width: 882px; }
.VotedStrip.vw-8 { width: 1008px; }
.VotedStrip.vw-9 { width: 1134px; }
.VotedStrip.vw-10 { width: 1260px; }
.VotedStrip.vw-11 { width: 1386px; }
.VotedStrip.vw-12 { width: 1512px; }
.VotedStrip.vw-13 { width: 1638px; }
.VotedStrip.vw-14 { width: 1764px; }
.VotedStrip.vw-15 { width: 1890px; }
.VotedStrip.vw-16 { width: 2016px; }
.VotedStrip.vw-17 { width: 2142px; }
.VotedStrip.vw-18 { width: 2268px; }
.VotedStrip.vw-19 { width: 2394px; }
.VotedStrip.vw-20 { width: 2520px; }
.VotedStrip.vw-21 { width: 2646px; }
.VotedStrip.vw-22 { width: 2772px; }
.VotedStrip.vw-23 { width: 2898px; }
.VotedStrip.vw-24 { width: 3024px; }
.VotedStrip.vw-25 { width: 3150px; }
.VotedStrip.vw-26 { width: 3276px; }
.VotedStrip.vw-27 { width: 3402px; }
.VotedStrip.vw-28 { width: 3528px; }
.VotedStrip.vw-29 { width: 3654px; }
.VotedStrip.vw-30 { width: 3780px; }
.VotedStrip.vw-31 { width: 3906px; }
.VotedStrip.vw-32 { width: 4032px; }
.VotedStrip.vw-33 { width: 4158px; }
.VotedStrip.vw-34 { width: 4284px; }
.VotedStrip.vw-35 { width: 4410px; }
.VotedStrip.vw-36 { width: 4536px; }
.VotedStrip.vw-37 { width: 4662px; }
.VotedStrip.vw-38 { width: 4788px; }
.VotedStrip.vw-39 { width: 4914px; }
.VotedStrip.vw-40 { width: 5040px; }
.VotedStrip.vw-41 { width: 5166px; }
.VotedStrip.vw-42 { width: 5292px; }
.VotedStrip.vw-43 { width: 5418px; }
.VotedStrip.vw-44 { width: 5544px; }
.VotedStrip.vw-45 { width: 5670px; }
.VotedStrip.vw-46 { width: 5796px; }
.VotedStrip.vw-47 { width: 5922px; }
.VotedStrip.vw-48 { width: 6048px; }
.VotedStrip.vw-49 { width: 6174px; }
.VotedStrip.vw-50 { width: 6300px; }

.FilterBar
{
	width: 100%;
	height: 36px;
	flow-children: right;
	horizontal-align: center;
	vertical-align: middle;
	padding-left: 12px;
	padding-right: 12px;
	margin-bottom: 4px;
}

.FilterBar.is-off
{
	visibility: collapse;
}

.FilterTypeRow,
.FilterSortRow
{
	height: 36px;
	flow-children: right;
	vertical-align: middle;
}

.FilterSortRow
{
	margin-left: 16px;
}

.FilterChip
{
	height: 28px;
	min-width: 72px;
	padding-left: 12px;
	padding-right: 12px;
	margin-right: 8px;
	vertical-align: middle;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
	flow-children: none;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
	wash-color: none;
}

.FilterChip.is-off
{
	visibility: collapse;
}

.FilterChip:hover
{
	background-color: #ffffff1c;
	sound: "UIPanorama.generic_button_rollover";
}

.FilterChip:active
{
	background-color: #ffffff2e;
	brightness: 0.9;
	sound: "UIPanorama.generic_button_press";
}

.FilterChip.is-active
{
	background-color: #ff9a1a22;
	border: 1px solid #ff9a1a;
}

.FilterChip.is-active:hover
{
	background-color: #ff9a1a44;
}

.FilterChipLabel
{
	width: 100%;
	height: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	white-space: nowrap;
}

.FilterChip.is-active .FilterChipLabel
{
	color: #ffd27a;
}

.MapGridHost
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: none;
}

.MapGrid
{
	width: 100%;
	height: 100%;
	overflow: squish scroll;
	flow-children: down;
}

.MapEmpty
{
	width: 100%;
	height: 36px;
	horizontal-align: center;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 16;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #a3acb6;
	margin-top: 24px;
}

.MapEmpty.is-off
{
	visibility: collapse;
}

.MapGridFadeTop
{
	width: 100%;
	height: 64px;
	vertical-align: top;
	z-index: 5;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000f2 ), color-stop( 0.45, #00000099 ), to( #00000000 ) );
}

.MapGridFadeBottom
{
	width: 100%;
	height: 48px;
	vertical-align: bottom;
	z-index: 5;
	background-color: gradient( linear, 0% 100%, 0% 0%, from( #000000e6 ), color-stop( 0.5, #00000066 ), to( #00000000 ) );
}

.MapCatalog
{
	width: 100%;
	flow-children: down;
	overflow: noclip noclip;
	horizontal-align: center;
	padding-left: 12px;
	padding-right: 12px;
}

.MapCatalog.rows-0 { height: 0px; }
.MapCatalog.rows-1 { height: 213px; }
.MapCatalog.rows-2 { height: 426px; }
.MapCatalog.rows-3 { height: 639px; }
.MapCatalog.rows-4 { height: 852px; }
.MapCatalog.rows-5 { height: 1065px; }

.CatalogRow
{
	width: 100%;
	height: 213px;
	flow-children: right;
	horizontal-align: center;
}

.CatalogRow.is-off
{
	visibility: collapse;
}

.MapSlot
{
	width: 110px;
	height: 213px;
	horizontal-align: center;
	flow-children: none;
	margin: 0px 8px 0px 8px;
}

.CatalogRow .MapSlot
{
	width: fill-parent-flow( 1.0 );
}

.MapSlot.is-off
{
	visibility: collapse;
}

.MapTile
{
	width: 100%;
	height: 193px;
	vertical-align: middle;
	border: 0px solid #cacaca1a;
	box-shadow: none;
	wash-color: none;
	overflow: clip;
	flow-children: none;
	transition-property: brightness, opacity;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

.MapTile.is-self
{
	border: 2px solid #ffffff;
	box-shadow: #ffffff 0px 0px 6px 0px;
}

.MapTile.is-lost
{
	wash-color: #000000;
	brightness: 0.55;
	border: 0px solid #cacaca1a;
	box-shadow: none;
	transition-property: wash-color, brightness, opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.MapTile:hover
{
	sound: "UIPanorama.submenu_contents_rollover";
}

.MapTile:active
{
	sound: "UIPanorama.submenu_select";
}

.MapTile.is-lost:hover .MapShot,
.MapTile.is-done:hover .MapShot
{
	transform: scale3d( 1.0, 1.0, 1.0 );
}

.MapShot
{
	width: 100%;
	height: 100%;
	z-index: 0;
	transform: scale3d( 1.0, 1.0, 1.0 );
	background-repeat: no-repeat;
	background-size: 343px 193px;
	background-position: 50% 50%;
	transition-property: transform, opacity;
	transition-duration: 0.25s, 2.0s;
	transition-timing-function: ease-out;
}

.MapTile:hover .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

.MapTile.is-self .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

.MapFade
{
	width: 100%;
	height: 100%;
	z-index: 1;
	/* Clear through mid-tile; shadow ramps below for vote count + name. */
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #00000000 ), color-stop( 0.5, #00000000 ), color-stop( 0.7, #000000aa ), to( #000000ff ) );
}

.MapVotes
{
	width: 100%;
	z-index: 2;
	vertical-align: bottom;
	horizontal-align: center;
	margin: 0px;
	margin-bottom: 40px;
	font-family: Stratum2;
	font-size: 26;
	color: #ff9a1a;
	text-align: center;
}

.MapName
{
	width: 90%;
	height: 36px;
	z-index: 2;
	margin: 0px 4px 6px 4px;
	vertical-align: bottom;
	horizontal-align: center;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 16;
	color: #ffffff;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.FavBtn
{
	width: 28px;
	height: 28px;
	horizontal-align: right;
	vertical-align: top;
	/* MapTile is 193px centered in 213px MapSlot → 10px top gap; +4px inset. */
	margin-top: 14px;
	margin-right: 4px;
	z-index: 4;
	flow-children: none;
	wash-color: none;
	background-color: #00000066;
	border-radius: 3px;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.FavBtn:hover
{
	background-color: #00000099;
	brightness: 1.1;
	sound: "UIPanorama.generic_button_rollover";
}

.FavBtn:active
{
	brightness: 0.85;
	sound: "UIPanorama.generic_button_press";
}

.FavIcon
{
	width: 20px;
	height: 20px;
	horizontal-align: center;
	vertical-align: middle;
	background-image: url( "s2r://panorama/images/icons/ui/favorite_no.vsvg" );
	background-size: 20px 20px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
}

.FavBtn.is-on .FavIcon
{
	background-image: url( "s2r://panorama/images/icons/ui/favorite_yes.vsvg" );
}

@keyframes 'mv-winner-pulse'
{
	0%
	{
		border: 2px solid #ffffff00;
	}

	50%
	{
		border: 5px solid #ffff00;
	}

	100%
	{
		border: 2px solid #ffffff;
	}
}

.MapTile.is-done
{
	wash-color: none;
	brightness: 1.0;
	border: 2px solid #ffffff;
	box-shadow: #ffffff 0px 0px 6px 0px;
	animation-name: 'mv-winner-pulse';
	animation-duration: 0.5s;
	animation-timing-function: ease-out;
	animation-iteration-count: 1;
}

.MapTile.is-done .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

.MapWinnerCheck
{
	width: 50px;
	height: 50px;
	z-index: 3;
	vertical-align: middle;
	horizontal-align: center;
	background-image: url( "s2r://panorama/images/icons/ui/vote_check.vsvg" );
	background-size: 50px 50px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	wash-color: #2bff00;
	opacity: 0.0;
	transform: scale3d( 2.0, 2.0, 1.0 );
	transition-property: transform, opacity;
	transition-duration: 0.1s;
	transition-timing-function: ease-out;
}

@keyframes 'mv-check-appear'
{
	0%
	{
		opacity: 0.0;
		transform: scale3d( 2.0, 2.0, 1.0 );
	}

	100%
	{
		opacity: 1.0;
		transform: scale3d( 1.0, 1.0, 1.0 );
	}
}

.MapTile.is-done .MapWinnerCheck
{
	opacity: 1.0;
	transform: scale3d( 1.0, 1.0, 1.0 );
	animation-name: 'mv-check-appear';
	animation-duration: 0.1s;
	animation-timing-function: ease-out;
	animation-iteration-count: 1;
	animation-delay: 0.35s;
}

.CreditBar
{
	width: 100%;
	height: 30px;
	background-color: #0b0f14f2;
	flow-children: none;
}

.CreditLabel
{
	width: 100%;
	height: 30px;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 22;
	color: #ffffff;
	white-space: nowrap;
}

/* BEGIN mv-map-palette */
/* Map screenshots — class names must stay ASCII-safe for CustomHud.SetHasClass.
   `make images` rewrites this block from extracted PNGs. */
.mv-map-default { background-image: url( "s2r://panorama/images/custom_game/mapvote/maps/default.vtex" ); }
/* END mv-map-palette */
