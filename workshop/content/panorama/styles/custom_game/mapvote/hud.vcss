/* MapVote HUD — Panorama CSS only (see workshop/panorama-css.md). */

@keyframes mv-in
{
	0%
	{
		transform: scale3d( 0.96, 0.96, 1.0 );
		opacity: 0.0;
	}
	100%
	{
		transform: scale3d( 1.0, 1.0, 1.0 );
		opacity: 1.0;
	}
}

@keyframes mv-out
{
	0%
	{
		transform: scale3d( 1.0, 1.0, 1.0 );
		opacity: 1.0;
	}
	100%
	{
		transform: scale3d( 0.96, 0.96, 1.0 );
		opacity: 0.0;
	}
}

@keyframes mv-bump
{
	0%
	{
		transform: scale3d( 1.06, 1.06, 1.0 );
	}
	100%
	{
		transform: scale3d( 1.0, 1.0, 1.0 );
	}
}

.HudScreen
{
	width: 100%;
	height: 100%;
}

.VoteRoot,
.VoteRoot.ph-fs
{
	width: 100%;
	height: 100%;
	horizontal-align: center;
	vertical-align: middle;
}

.VoteRoot.ph-card
{
	background-color: #00000000;
	overflow: noclip;
}

.VoteRoot.ph-on
{
	animation-name: mv-in;
	animation-duration: 0.22s;
	animation-timing-function: ease-out;
	animation-fill-mode: forwards;
}

.VoteRoot.ph-off
{
	animation-name: mv-out;
	animation-duration: 0.16s;
	animation-timing-function: ease-in;
	animation-fill-mode: forwards;
}

.mv-bg
{
	width: 100%;
	height: 100%;
	background-color: #0a101844;
	world-blur: hologram;
	ignore-parent-flow: true;
}

/* Stage fits ten 163px cards with 48px gaps: 10×163 + 9×48 = 2062. */
.VoteBody
{
	width: 100%;
	max-width: 2062px;
	height: 100%;
	horizontal-align: center;
	flow-children: down;
}

/* Width-relative lead-in so the first card row tracks Valve's thumb band. */
.ThumbLead
{
	width: 100%;
	height: width-percentage( 4.7% );
}

/* Voted maps only: one row, horizontal scroll when more than fit. */
.VotedRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	overflow: scroll clip;
}

.VotedRow.is-empty
{
	visibility: collapse;
}

/* Full catalog: wrap + vertical scroll only (no horizontal bar). */
.MapGrid
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right-wrap;
	overflow: clip scroll;
	horizontal-align: center;
}

.VoteRoot.is-reveal .ThumbLead,
.VoteRoot.is-reveal .VotedRow,
.VoteRoot.is-reveal .MapGrid
{
	visibility: collapse;
}

/* CS2 map-vote card size and gap. */
.MapTile
{
	width: 163px;
	height: 286px;
	margin-right: 48px;
	margin-bottom: 48px;
	transition-property: transform, box-shadow;
	transition-duration: 0.12s;
	transition-timing-function: ease-out;
	overflow: noclip;
}

.VotedRow .MapTile
{
	margin-bottom: 0px;
}

.MapTile:hover
{
	transform: scale3d( 1.03, 1.03, 1.0 );
	box-shadow: #00000088 0px 8px 22px 0px;
}

.MapTile:active
{
	transform: scale3d( 0.98, 0.98, 1.0 );
	sound: "UIPanorama.submenu_select";
	sound-optical: "UIPanorama.submenu_select";
}

.MapTile.is-empty
{
	visibility: collapse;
}

.MapTile.is-mine
{
	box-shadow: #f0c85a55 0px 0px 16px 0px;
}

.MapTile.bump-a,
.MapTile.bump-b
{
	animation-name: mv-bump;
	animation-duration: 0.28s;
	animation-timing-function: ease-out;
	animation-fill-mode: forwards;
}

.MapShot
{
	width: 100%;
	height: 100%;
	background-color: #10141caa;
	background-size: 100% 100%;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	border: 1px solid #e4e7eeaa;
}

.MapTile:hover .MapShot,
.MapTile.is-voted .MapShot
{
	border: 1px solid #9eb6ffcc;
}

.MapTile.is-mine .MapShot
{
	border: 3px solid #f0c85a;
	border-top: 1px solid #f0c85a;
	border-right: 1px solid #f0c85a;
}

.MapCaption
{
	width: 100%;
	height: fit-children;
	horizontal-align: center;
	vertical-align: bottom;
	flow-children: down;
	padding: 18px 6px 8px 6px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #00000000 ), to( #000000cc ) );
}

.MapVotes,
.MapName
{
	horizontal-align: center;
	text-align: center;
	width: 100%;
	color: #ffffff;
	text-shadow: #000000 0px 0px 3px 0px,
		#000000 1px 1px 0px 0px,
		#000000 -1px -1px 0px 0px,
		#000000 1px -1px 0px 0px,
		#000000 -1px 1px 0px 0px;
}

.MapVotes
{
	font-size: 22;
}

.MapName
{
	font-size: 14;
	color: #e8ecf4;
	margin-top: 2px;
}

.Winner
{
	width: 720px;
	height: fit-children;
	horizontal-align: center;
	vertical-align: middle;
	flow-children: down;
	margin-top: 40px;
}

.Winner.is-empty
{
	visibility: collapse;
}

.WinnerFrame
{
	width: 720px;
	height: 405px;
	overflow: noclip;
}

.WinnerShot
{
	width: 720px;
	height: 405px;
	border: 2px solid #f0c85a;
	border-left: 4px solid #f0c85a;
	border-bottom: 4px solid #f0c85a;
	box-shadow: #f0c85a66 0px 0px 28px 0px;
	background-color: #10141ccc;
	background-size: 100% 100%;
	background-repeat: no-repeat;
	background-position: 50% 50%;
}

.WinnerName
{
	horizontal-align: center;
	margin-top: 18px;
	font-size: 40;
	color: #f2f5ff;
	text-shadow: #000000aa 0px 2px 10px 0px;
}

.WinnerVotes
{
	horizontal-align: right;
	vertical-align: bottom;
	margin: 0px 16px 12px 0px;
	font-size: 36;
	color: #ffffff;
	text-shadow: #000000 0px 0px 3px 0px,
		#000000 1px 1px 0px 0px,
		#000000 -1px -1px 0px 0px,
		#000000 1px -1px 0px 0px,
		#000000 -1px 1px 0px 0px;
}

.Winner.tick-a .WinnerShot
{
	brightness: 1.08;
}

.Winner.tick-b .WinnerShot
{
	brightness: 0.92;
}

/* BEGIN mv-map-palette */
/* Map screenshots — class names must stay ASCII-safe for CustomHud.SetHasClass.
   `make images` rewrites this block from extracted PNGs. */
.mv-map-default { background-image: url( "s2r://panorama/images/custom_game/mapvote/maps/default.vtex" ); }
/* END mv-map-palette */
