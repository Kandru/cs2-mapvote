/* MapVote HUD — Panorama CSS only (see workshop/panorama-css.md). */

@keyframes mv-in
{
	0%
	{
		transform: scale3d( 0.96, 0.96, 1.0 );
		opacity: 0.0;
	}
	100%
	{
		transform: scale3d( 1.0, 1.0, 1.0 );
		opacity: 1.0;
	}
}

@keyframes mv-out
{
	0%
	{
		transform: scale3d( 1.0, 1.0, 1.0 );
		opacity: 1.0;
	}
	100%
	{
		transform: scale3d( 0.96, 0.96, 1.0 );
		opacity: 0.0;
	}
}

@keyframes mv-bump
{
	0%
	{
		transform: scale3d( 1.06, 1.06, 1.0 );
	}
	100%
	{
		transform: scale3d( 1.0, 1.0, 1.0 );
	}
}

.HudScreen
{
	width: 100%;
	height: 100%;
}

.VoteRoot
{
	width: 100%;
	height: 100%;
	horizontal-align: center;
	vertical-align: middle;
}

.VoteRoot.ph-fs
{
	width: 100%;
	height: 100%;
}

.VoteRoot.ph-card
{
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #0d1118ee ), to( #121820f2 ) );
	border: 1px solid #ffffff14;
	box-shadow: #000000aa 0px 18px 48px 0px;
	overflow: noclip;
}

.VoteRoot.ph-on
{
	animation-name: mv-in;
	animation-duration: 0.22s;
	animation-timing-function: ease-out;
	animation-fill-mode: forwards;
}

.VoteRoot.ph-off
{
	animation-name: mv-out;
	animation-duration: 0.16s;
	animation-timing-function: ease-in;
	animation-fill-mode: forwards;
}

.mv-bg
{
	width: 100%;
	height: 100%;
	background-color: #070a10cc;
	background-image: url( "s2r://panorama/images/backgrounds/bluedots_large_png.vtex" );
	background-size: auto auto;
	background-img-opacity: 0.04;
	wash-color: #7aa2ff;
	saturation: 0.35;
	world-blur: hologram;
	ignore-parent-flow: true;
}

.VoteBody
{
	width: 100%;
	height: 100%;
	flow-children: down;
	padding: 36px 40px 36px 40px;
}

.VoteHeader
{
	width: 100%;
	flow-children: right;
	margin-bottom: 16px;
}

.VoteTitle
{
	font-size: 42;
	color: #f2f5ff;
	text-shadow: #000000aa 0px 2px 10px 0px;
	horizontal-align: left;
	vertical-align: middle;
}

.VoteTimer
{
	font-size: 36;
	color: #9eb6ff;
	text-shadow: #000000aa 0px 2px 10px 0px;
	horizontal-align: right;
	vertical-align: middle;
	width: fill-parent-flow( 1.0 );
	text-align: right;
}

/* Top strip: maps with votes, sorted by count. Horizontal scroll when >5. */
.VotedRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	overflow: scroll noclip;
	margin-bottom: 14px;
	padding-bottom: 6px;
}

.VotedRow.is-empty
{
	visibility: collapse;
	height: 0px;
	margin-bottom: 0px;
	padding-bottom: 0px;
}

/* Full catalog. Vertical scroll + wrap, five columns. */
.MapGrid
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right-wrap;
	overflow: squish scroll;
	horizontal-align: center;
	padding-top: 4px;
}

.VoteRoot.is-reveal .VotedRow,
.VoteRoot.is-reveal .MapGrid
{
	visibility: collapse;
}

/* Five per row: padding replaces margin so 5×20% = 100%. */
.MapTile
{
	width: 20%;
	height: width-percentage( 56.25% );
	padding: 8px;
	background-color: #00000000;
	transition-property: transform, box-shadow;
	transition-duration: 0.12s;
	transition-timing-function: ease-out;
	overflow: noclip;
}

.MapTile:hover
{
	transform: scale3d( 1.02, 1.02, 1.0 );
	box-shadow: #00000088 0px 10px 28px 0px;
}

.MapTile:active
{
	transform: scale3d( 0.98, 0.98, 1.0 );
	sound: "UIPanorama.submenu_select";
	sound-optical: "UIPanorama.submenu_select";
}

.MapTile.is-empty
{
	visibility: collapse;
}

.MapTile.is-mine
{
	box-shadow: #f0c85a55 0px 0px 18px 0px;
}

.MapTile.bump-a,
.MapTile.bump-b
{
	animation-name: mv-bump;
	animation-duration: 0.28s;
	animation-timing-function: ease-out;
	animation-fill-mode: forwards;
}

.MapShot
{
	width: 100%;
	height: 100%;
	background-color: #1a2430;
	background-size: 100% 100%;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	border: 2px solid #ffffff18;
	saturation: 0.0;
}

.MapTile:hover .MapShot
{
	border: 2px solid #9eb6ffaa;
	saturation: 1.0;
}

.MapTile.is-voted .MapShot
{
	border: 2px solid #9eb6ff88;
	saturation: 1.0;
	blur: gaussian( 2.5 );
}

.MapTile.is-mine .MapShot
{
	border: 2px solid #f0c85a;
	saturation: 1.0;
}

.MapVotes
{
	horizontal-align: right;
	vertical-align: bottom;
	margin: 0px 18px 16px 0px;
	font-size: 28;
	color: #ffffff;
	text-shadow: #000000cc 0px 2px 6px 0px;
}

.MapVotesBack
{
	color: #000000;
	text-shadow: #000000 1px 1px 0px 0px,
		#000000 -1px -1px 0px 0px,
		#000000 1px -1px 0px 0px,
		#000000 -1px 1px 0px 0px;
	z-index: -1;
}

.Winner
{
	width: 720px;
	height: fit-children;
	horizontal-align: center;
	vertical-align: middle;
	flow-children: down;
	margin-top: 40px;
}

.Winner.is-empty
{
	visibility: collapse;
}

.WinnerFrame
{
	width: 720px;
	height: 405px;
	overflow: noclip;
}

.WinnerShot
{
	width: 720px;
	height: 405px;
	border: 3px solid #f0c85a;
	box-shadow: #f0c85a66 0px 0px 28px 0px;
	background-color: #1a2430;
	background-size: 100% 100%;
	background-repeat: no-repeat;
	background-position: 50% 50%;
}

.WinnerName
{
	horizontal-align: center;
	margin-top: 18px;
	font-size: 40;
	color: #f2f5ff;
	text-shadow: #000000aa 0px 2px 10px 0px;
}

.WinnerVotes
{
	horizontal-align: right;
	vertical-align: bottom;
	margin: 0px 16px 12px 0px;
	font-size: 36;
	color: #ffffff;
	text-shadow: #000000cc 0px 2px 6px 0px;
}

.Winner.tick-a .WinnerShot
{
	brightness: 1.08;
}

.Winner.tick-b .WinnerShot
{
	brightness: 0.92;
}

/* BEGIN mv-map-palette */
/* Map screenshots — class names must stay ASCII-safe for CustomHud.SetHasClass.
   `make images` rewrites this block from extracted PNGs. */
.mv-map-default { background-image: url( "s2r://panorama/images/custom_game/mapvote/maps/default.vtex" ); }
/* END mv-map-palette */
