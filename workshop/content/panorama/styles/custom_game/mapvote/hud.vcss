/* MapVote HUD — port of CS2 end-of-match vote styles (ruleset-safe).
   Sources: stuff/panorama/styles/endofmatch-voting.css
            stuff/panorama/styles/endofmatch.css
            stuff/panorama/styles/mainmenu_play.css (.map-selection-btn*)
   Layout extras (50 maps, scroll, voted strip) keep Valve tile metrics. */

.HudScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

.VoteRoot
{
	width: 100%;
	height: 100%;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

.VoteRoot.is-fading
{
	opacity: 0.0;
	transition-duration: 0.18s;
	transition-timing-function: ease-in;
}

.VoteRoot.is-off
{
	visibility: collapse;
}

/* Light frost (~5%) — darkening comes from Valve .eom / .eom-layout scrims below. */
.mv-glass
{
	width: 100%;
	height: 100%;
	background-color: #0000000d;
	world-blur: gaussian( 1 );
	ignore-parent-flow: true;
}

/* .eom-layout */
.mv-scrim-top
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000e0 ), to( #00000000 ) );
	ignore-parent-flow: true;
}

/* .eom */
.mv-scrim-bottom
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 100%, 0% 0%, from( #000000a0 ), color-stop( 0.5, #00000000 ), to( #00000000 ) );
	ignore-parent-flow: true;
}

.VoteColumn
{
	width: 100%;
	height: 100%;
	flow-children: down;
}

/* #id-eom-layout margin-top: 48px */
.VoteTopSpacer
{
	width: 100%;
	height: 48px;
}

/* Full-bleed stage — scrollbar on screen edge; cards centered. */
.VoteBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	/* #id-map-selection-container margin-top: 12px */
	padding-top: 12px;
}

/* Row 1: voted maps (Valve list is one right-flow row). */
.VotedRow
{
	width: 100%;
	height: 213px;
	overflow: squish scroll;
	horizontal-align: center;
	margin-bottom: 8px;
}

.VotedRow.is-off
{
	visibility: collapse;
}

.VotedStrip
{
	height: 213px;
	flow-children: right;
	overflow: noclip noclip;
	horizontal-align: center;
}

.VotedStrip.vw-0 { width: 0px; }
.VotedStrip.vw-1 { width: 142px; }
.VotedStrip.vw-2 { width: 284px; }
.VotedStrip.vw-3 { width: 426px; }
.VotedStrip.vw-4 { width: 568px; }
.VotedStrip.vw-5 { width: 710px; }
.VotedStrip.vw-6 { width: 852px; }
.VotedStrip.vw-7 { width: 994px; }
.VotedStrip.vw-8 { width: 1136px; }
.VotedStrip.vw-9 { width: 1278px; }
.VotedStrip.vw-10 { width: 1420px; }
.VotedStrip.vw-11 { width: 1562px; }
.VotedStrip.vw-12 { width: 1704px; }
.VotedStrip.vw-13 { width: 1846px; }
.VotedStrip.vw-14 { width: 1988px; }
.VotedStrip.vw-15 { width: 2130px; }
.VotedStrip.vw-16 { width: 2272px; }
.VotedStrip.vw-17 { width: 2414px; }
.VotedStrip.vw-18 { width: 2556px; }
.VotedStrip.vw-19 { width: 2698px; }
.VotedStrip.vw-20 { width: 2840px; }
.VotedStrip.vw-21 { width: 2982px; }
.VotedStrip.vw-22 { width: 3124px; }
.VotedStrip.vw-23 { width: 3266px; }
.VotedStrip.vw-24 { width: 3408px; }
.VotedStrip.vw-25 { width: 3550px; }
.VotedStrip.vw-26 { width: 3692px; }
.VotedStrip.vw-27 { width: 3834px; }
.VotedStrip.vw-28 { width: 3976px; }
.VotedStrip.vw-29 { width: 4118px; }
.VotedStrip.vw-30 { width: 4260px; }
.VotedStrip.vw-31 { width: 4402px; }
.VotedStrip.vw-32 { width: 4544px; }
.VotedStrip.vw-33 { width: 4686px; }
.VotedStrip.vw-34 { width: 4828px; }
.VotedStrip.vw-35 { width: 4970px; }
.VotedStrip.vw-36 { width: 5112px; }
.VotedStrip.vw-37 { width: 5254px; }
.VotedStrip.vw-38 { width: 5396px; }
.VotedStrip.vw-39 { width: 5538px; }
.VotedStrip.vw-40 { width: 5680px; }
.VotedStrip.vw-41 { width: 5822px; }
.VotedStrip.vw-42 { width: 5964px; }
.VotedStrip.vw-43 { width: 6106px; }
.VotedStrip.vw-44 { width: 6248px; }
.VotedStrip.vw-45 { width: 6390px; }
.VotedStrip.vw-46 { width: 6532px; }
.VotedStrip.vw-47 { width: 6674px; }
.VotedStrip.vw-48 { width: 6816px; }
.VotedStrip.vw-49 { width: 6958px; }
.VotedStrip.vw-50 { width: 7100px; }

/* Extra maps beyond Valve's single row — full-width scroll. */
.MapGrid
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	overflow: squish scroll;
}

.MapCatalog
{
	width: 100%;
	max-width: 1420px;
	flow-children: down;
	overflow: noclip noclip;
	horizontal-align: center;
}

.MapCatalog.rows-0 { height: 0px; }
.MapCatalog.rows-1 { height: 213px; }
.MapCatalog.rows-2 { height: 426px; }
.MapCatalog.rows-3 { height: 639px; }
.MapCatalog.rows-4 { height: 852px; }
.MapCatalog.rows-5 { height: 1065px; }

.CatalogRow
{
	width: 100%;
	height: 213px;
	flow-children: right;
	horizontal-align: center;
}

.CatalogRow.is-off
{
	visibility: collapse;
}

/* ---- .map-selection-btn + .map-selection-btn--vote ---- */
.MapTile
{
	/* --vote: 110 × 175% (ruleset: no width-percentage → 193px) */
	width: 110px;
	height: 193px;
	horizontal-align: center;
	margin: 10px 16px 10px 16px;
	/* base .map-selection-btn border, then --vote clears shadow */
	border: 0px solid #cacaca1a;
	box-shadow: none;
	wash-color: none;
	overflow: clip;
	flow-children: none;
	/* base transition (box-shadow omitted — ruleset) */
	transition-property: border, brightness, opacity;
	transition-duration: 0.25s;
	transition-timing-function: ease-in-out;
}

.MapTile.is-off
{
	visibility: collapse;
}

/* .map-selection-btn--vote:selected */
.MapTile.is-self
{
	border: 2px solid #ffffff;
	box-shadow: #ffffff 0px 0px 6px 0px;
}

.MapTile:hover
{
	sound: "UIPanorama.submenu_contents_rollover";
}

.MapTile:active
{
	sound: "UIPanorama.submenu_select";
}

/* .map-selection-btn__screenshot — fill tile; 16:9 at full height, centered (no stretch). */
.MapShot
{
	width: 100%;
	height: 100%;
	z-index: 0;
	ignore-parent-flow: true;
	transform: scale3d( 1.0, 1.0, 1.0 );
	background-repeat: no-repeat;
	background-size: 343px 193px;
	background-position: 50% 50%;
	transition-property: transform, opacity;
	transition-duration: 0.25s, 2.0s;
	transition-timing-function: ease-in-out;
}

/* endofmatch-voting: Hover screenshot → 1.2 */
.MapTile:hover .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

/* play: selected screenshot → 1.2 */
.MapTile.is-self .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

/* Shadow mask on top of the shot (Valve .map-selection-btn__gradient).
   Soft at the top, hard black at the bottom so name + count stay readable. */
.MapFade
{
	width: 100%;
	height: 100%;
	z-index: 1;
	ignore-parent-flow: true;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #00000000 ), color-stop( 0.35, #00000040 ), color-stop( 0.65, #000000cc ), to( #000000ff ) );
}

/* Vote count — CS2 html count is amber; CSS fallback #ff9a1a.
   Bold Stratum2, 26px (Label.map-selection-item-count). */
.MapVotes
{
	width: 100%;
	z-index: 2;
	ignore-parent-flow: true;
	vertical-align: bottom;
	horizontal-align: center;
	margin: 0px;
	margin-bottom: 40px;
	font-family: Stratum2 Bold;
	font-weight: bold;
	font-size: 26;
	color: #ff9a1a;
	text-align: center;
}

/* RadioButton.map-selection-btn--vote Label + .map-selection-info__map-name */
.MapName
{
	width: 90%;
	height: 36px;
	z-index: 2;
	ignore-parent-flow: true;
	margin: 0px 4px 0px 4px;
	vertical-align: bottom;
	horizontal-align: center;
	text-align: center;
	font-size: 16;
	color: #ffffff;
	text-overflow: ellipsis;
	white-space: nowrap;
}

/* #id-map-selection-btn__winner */
.MapWinnerCheck
{
	width: 50px;
	height: 50px;
	z-index: 3;
	ignore-parent-flow: true;
	vertical-align: middle;
	horizontal-align: center;
	background-image: url( "s2r://panorama/images/icons/ui/vote_check.vsvg" );
	background-size: 50px 50px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	wash-color: #2bff00;
	opacity: 0.0;
	transform: scale3d( 2.0, 2.0, 1.0 );
	transition-property: transform, opacity;
	transition-duration: 0.1s;
	transition-timing-function: ease-in-out;
}

/* #id-map-selection-btn__winner.appear */
.MapTile.is-done .MapWinnerCheck
{
	opacity: 1.0;
	transform: scale3d( 1.0, 1.0, 1.0 );
}

/* BEGIN mv-map-palette */
/* Map screenshots — class names must stay ASCII-safe for CustomHud.SetHasClass.
   `make images` rewrites this block from extracted PNGs. */
.mv-map-default { background-image: url( "s2r://panorama/images/custom_game/mapvote/maps/default.vtex" ); }
/* END mv-map-palette */
