/* MapVote HUD — CS2 end-of-match vote tiles, fullscreen + scroll (see workshop/panorama-css.md).
   Cards = Valve map-selection-btn--vote. Stage width fits 10 cards (Valve eom row). */

@keyframes mv-in
{
	0%
	{
		transform: scale3d( 0.96, 0.96, 1.0 );
		opacity: 0.0;
	}
	100%
	{
		transform: scale3d( 1.0, 1.0, 1.0 );
		opacity: 1.0;
	}
}

@keyframes mv-out
{
	0%
	{
		transform: scale3d( 1.0, 1.0, 1.0 );
		opacity: 1.0;
	}
	100%
	{
		transform: scale3d( 0.96, 0.96, 1.0 );
		opacity: 0.0;
	}
}

.HudScreen
{
	width: 100%;
	height: 100%;
}

.VoteRoot,
.VoteRoot.ph-fs
{
	width: 100%;
	height: 100%;
	horizontal-align: center;
	vertical-align: middle;
}

.VoteRoot.ph-card
{
	background-color: #00000000;
	overflow: noclip;
}

.VoteRoot.ph-on
{
	animation-name: mv-in;
	animation-duration: 0.22s;
	animation-timing-function: ease-out;
	animation-fill-mode: forwards;
}

.VoteRoot.ph-off
{
	animation-name: mv-out;
	animation-duration: 0.16s;
	animation-timing-function: ease-in;
	animation-fill-mode: forwards;
}

/* Top-dark scrim like Valve .eom-layout. */
.mv-bg
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000e0 ), to( #00000000 ) );
	ignore-parent-flow: true;
}

/* 10 cards: 10×110 + 10×32 margin = 1420 (Valve ~10-across vote row). */
.VoteBody
{
	width: 100%;
	max-width: 1420px;
	height: 100%;
	horizontal-align: center;
	flow-children: down;
	padding-top: 12px;
}

/* Row 1: maps that have votes — one strip, h-scroll if needed. */
.VotedRow
{
	width: 100%;
	height: fit-children;
	flow-children: right;
	overflow: scroll clip;
	horizontal-align: center;
	margin-bottom: 8px;
}

.VotedRow.is-empty
{
	visibility: collapse;
}

.VotedRow .MapTile
{
	margin-bottom: 0px;
}

/* Catalog: same 10-across wrap, fill leftover height, v-scroll. */
.MapGrid
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right-wrap;
	overflow: squish scroll;
	horizontal-align: center;
}

/* ---- Valve .map-selection-btn--vote ---- */
.MapTile
{
	width: 110px;
	height: width-percentage( 175% );
	margin: 10px 16px 10px 16px;
	border: 0px solid #cacaca1a;
	box-shadow: none;
	wash-color: none;
	overflow: clip;
	transition-property: border, box-shadow, brightness, opacity;
	transition-duration: 0.25s;
	transition-timing-function: ease-in-out;
}

.MapTile.is-empty
{
	visibility: collapse;
}

.MapTile.is-mine
{
	border: 2px solid #ffffff;
	box-shadow: #ffffff 0px 0px 6px 0px;
}

.MapShot
{
	width: 100%;
	height: 100%;
	pre-transform-scale2d: 1.0, 1.0;
	background-repeat: no-repeat;
	background-size: 100% 100%;
	background-position: 50% 50%;
	transition-property: opacity, pre-transform-scale2d;
	transition-duration: 2.0s, 0.25s;
	transition-timing-function: ease-in-out;
}

.MapTile:hover .MapShot
{
	pre-transform-scale2d: 1.2, 1.2;
	sound: "UIPanorama.submenu_contents_rollover";
	sound-optical: "UIPanorama.submenu_contents_rollover";
}

.MapTile.is-mine .MapShot
{
	pre-transform-scale2d: 1.2, 1.2;
}

.MapTile:active
{
	sound: "UIPanorama.submenu_select";
	sound-optical: "UIPanorama.submenu_select";
}

.MapFade
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #00000020 ), to( #000000ff ) );
}

/* Vote count only (no /max) — CS2 accent orange. */
.MapVotes
{
	vertical-align: bottom;
	horizontal-align: center;
	margin: 0px;
	margin-bottom: 40px;
	font-family: Stratum2 Bold;
	font-size: 26;
	color: #ff9a1a;
	text-align: center;
	text-shadow: #000000 0px 0px 3px 0px,
		#000000 1px 1px 0px 0px,
		#000000 -1px -1px 0px 0px,
		#000000 1px -1px 0px 0px,
		#000000 -1px 1px 0px 0px;
}

.MapName
{
	width: 90%;
	height: 36px;
	margin: 0px 4px 6px 4px;
	vertical-align: bottom;
	horizontal-align: center;
	text-align: center;
	font-size: 16;
	color: #ffffff;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.MapWinnerCheck
{
	wash-color: #2bff00;
	pre-transform-scale2d: 2.0, 2.0;
	width: 50px;
	height: width-percentage( 100% );
	vertical-align: middle;
	horizontal-align: center;
	img-shadow: 0px 0px 1px 1.0 #2bff00;
	transition-property: pre-transform-scale2d, opacity;
	transition-duration: 0.1s;
	transition-timing-function: ease-in-out;
	opacity: 0.0;
}

.MapTile.is-winner .MapWinnerCheck
{
	pre-transform-scale2d: 1.0, 1.0;
	opacity: 1.0;
}

/* BEGIN mv-map-palette */
/* Map screenshots — class names must stay ASCII-safe for CustomHud.SetHasClass.
   `make images` rewrites this block from extracted PNGs. */
.mv-map-default { background-image: url( "s2r://panorama/images/custom_game/mapvote/maps/default.vtex" ); }
/* END mv-map-palette */
