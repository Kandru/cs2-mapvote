/* MapVote HUD v2 - end-of-match vote and !maps browser (Panorama ruleset §5.1 subset only).
   Contract: vote_v2.xml, generated by tools/generate_vote_xml_v2.py (contract list in its docstring).
   Map image classes (mv-map-*) live in maps_v1.vcss; this sheet is UI only.
   Tokens (ruleset §7.1): surface #12171ee8 -> #0b0f14f2, raised #ffffff0d, hover #ffffff1c, press #ffffff2e,
   track #ffffff12, border #ffffff14, ink #f5f7fa, ink-soft #e8eef4, muted #a3acb6,
   accent #f0a531 (light #ffd27a), success #9ccf4f, danger #e05a5a.
   Type in 1080p units: minimum 14; countdown, status, ranking names, map names, button labels >= 18 (U15).
   Colour carries data: accent = interaction + own vote, success = winner + like, danger = dislike + last 5 s.
   Transitions only on opacity, transform, clip, background-color, brightness. One infinite animation (is-urgent). */

.HudScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

/* ---- Root and views ---- */

.VoteRoot
{
	width: 100%;
	height: 100%;
	flow-children: none;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

.VoteRoot.is-fading
{
	opacity: 0.0;
	transition-duration: 0.18s;
	transition-timing-function: ease-in;
}

.VoteRoot.is-off
{
	visibility: collapse;
}

.mv-glass
{
	width: 100%;
	height: 100%;
	background-color: #05090fb8;
	world-blur: gaussian( 3 );
	transition-property: opacity;
	transition-duration: 0.25s;
}

.mv-scrim
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000c0 ), color-stop( 0.3, #00000080 ), to( #000000c8 ) );
	transition-property: opacity;
	transition-duration: 0.25s;
}

.VoteColumn
{
	width: 100%;
	height: 100%;
	flow-children: down;
}

/* ---- Top bar: title, countdown, hide ---- */

.TopBar
{
	width: 100%;
	height: 64px;
	flow-children: none;
	padding: 0px 24px 0px 24px;
}

.VoteTitle
{
	width: fit-children;
	horizontal-align: left;
	vertical-align: middle;
	font-family: Stratum2 Bold Condensed;
	font-size: 26;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #f5f7fa;
	transition-property: opacity;
	transition-duration: 0.25s;
}

.Timer
{
	width: fit-children;
	height: 40px;
	horizontal-align: center;
	vertical-align: middle;
	flow-children: right;
	padding: 0px 12px 0px 12px;
	border-radius: 3px;
}

.TimerText
{
	width: 72px;
	vertical-align: middle;
	margin-right: 12px;
	text-align: right;
	font-family: Stratum2 Bold Condensed;
	font-size: 30;
	color: #f5f7fa;
}

.TimerTrack
{
	width: 320px;
	height: 10px;
	vertical-align: middle;
	overflow: clip;
	background-color: #ffffff12;
	border-radius: 5px;
}

/* Client-timed drain (§12.1): span-N sets the duration, is-running the target clip. */
.TimerFill
{
	width: 100%;
	height: 100%;
	background-color: #f0a531;
	clip: rect( 0%, 100%, 100%, 0% );
	transition-property: clip;
	transition-timing-function: linear;
	transition-duration: 0s;
}

/* BEGIN span-ladder */
.TimerFill.span-3 { transition-duration: 3.0s; }
.TimerFill.span-4 { transition-duration: 4.0s; }
.TimerFill.span-5 { transition-duration: 5.0s; }
.TimerFill.span-6 { transition-duration: 6.0s; }
.TimerFill.span-7 { transition-duration: 7.0s; }
.TimerFill.span-8 { transition-duration: 8.0s; }
.TimerFill.span-9 { transition-duration: 9.0s; }
.TimerFill.span-10 { transition-duration: 10.0s; }
.TimerFill.span-11 { transition-duration: 11.0s; }
.TimerFill.span-12 { transition-duration: 12.0s; }
.TimerFill.span-13 { transition-duration: 13.0s; }
.TimerFill.span-14 { transition-duration: 14.0s; }
.TimerFill.span-15 { transition-duration: 15.0s; }
.TimerFill.span-16 { transition-duration: 16.0s; }
.TimerFill.span-17 { transition-duration: 17.0s; }
.TimerFill.span-18 { transition-duration: 18.0s; }
.TimerFill.span-19 { transition-duration: 19.0s; }
.TimerFill.span-20 { transition-duration: 20.0s; }
.TimerFill.span-21 { transition-duration: 21.0s; }
.TimerFill.span-22 { transition-duration: 22.0s; }
.TimerFill.span-23 { transition-duration: 23.0s; }
.TimerFill.span-24 { transition-duration: 24.0s; }
.TimerFill.span-25 { transition-duration: 25.0s; }
.TimerFill.span-26 { transition-duration: 26.0s; }
.TimerFill.span-27 { transition-duration: 27.0s; }
.TimerFill.span-28 { transition-duration: 28.0s; }
.TimerFill.span-29 { transition-duration: 29.0s; }
.TimerFill.span-30 { transition-duration: 30.0s; }
.TimerFill.span-31 { transition-duration: 31.0s; }
.TimerFill.span-32 { transition-duration: 32.0s; }
.TimerFill.span-33 { transition-duration: 33.0s; }
.TimerFill.span-34 { transition-duration: 34.0s; }
.TimerFill.span-35 { transition-duration: 35.0s; }
.TimerFill.span-36 { transition-duration: 36.0s; }
.TimerFill.span-37 { transition-duration: 37.0s; }
.TimerFill.span-38 { transition-duration: 38.0s; }
.TimerFill.span-39 { transition-duration: 39.0s; }
.TimerFill.span-40 { transition-duration: 40.0s; }
.TimerFill.span-41 { transition-duration: 41.0s; }
.TimerFill.span-42 { transition-duration: 42.0s; }
.TimerFill.span-43 { transition-duration: 43.0s; }
.TimerFill.span-44 { transition-duration: 44.0s; }
.TimerFill.span-45 { transition-duration: 45.0s; }
.TimerFill.span-46 { transition-duration: 46.0s; }
.TimerFill.span-47 { transition-duration: 47.0s; }
.TimerFill.span-48 { transition-duration: 48.0s; }
.TimerFill.span-49 { transition-duration: 49.0s; }
.TimerFill.span-50 { transition-duration: 50.0s; }
.TimerFill.span-51 { transition-duration: 51.0s; }
.TimerFill.span-52 { transition-duration: 52.0s; }
.TimerFill.span-53 { transition-duration: 53.0s; }
.TimerFill.span-54 { transition-duration: 54.0s; }
.TimerFill.span-55 { transition-duration: 55.0s; }
.TimerFill.span-56 { transition-duration: 56.0s; }
.TimerFill.span-57 { transition-duration: 57.0s; }
.TimerFill.span-58 { transition-duration: 58.0s; }
.TimerFill.span-59 { transition-duration: 59.0s; }
.TimerFill.span-60 { transition-duration: 60.0s; }
.TimerFill.span-61 { transition-duration: 61.0s; }
.TimerFill.span-62 { transition-duration: 62.0s; }
.TimerFill.span-63 { transition-duration: 63.0s; }
.TimerFill.span-64 { transition-duration: 64.0s; }
.TimerFill.span-65 { transition-duration: 65.0s; }
.TimerFill.span-66 { transition-duration: 66.0s; }
.TimerFill.span-67 { transition-duration: 67.0s; }
.TimerFill.span-68 { transition-duration: 68.0s; }
.TimerFill.span-69 { transition-duration: 69.0s; }
.TimerFill.span-70 { transition-duration: 70.0s; }
.TimerFill.span-71 { transition-duration: 71.0s; }
.TimerFill.span-72 { transition-duration: 72.0s; }
.TimerFill.span-73 { transition-duration: 73.0s; }
.TimerFill.span-74 { transition-duration: 74.0s; }
.TimerFill.span-75 { transition-duration: 75.0s; }
.TimerFill.span-76 { transition-duration: 76.0s; }
.TimerFill.span-77 { transition-duration: 77.0s; }
.TimerFill.span-78 { transition-duration: 78.0s; }
.TimerFill.span-79 { transition-duration: 79.0s; }
.TimerFill.span-80 { transition-duration: 80.0s; }
.TimerFill.span-81 { transition-duration: 81.0s; }
.TimerFill.span-82 { transition-duration: 82.0s; }
.TimerFill.span-83 { transition-duration: 83.0s; }
.TimerFill.span-84 { transition-duration: 84.0s; }
.TimerFill.span-85 { transition-duration: 85.0s; }
.TimerFill.span-86 { transition-duration: 86.0s; }
.TimerFill.span-87 { transition-duration: 87.0s; }
.TimerFill.span-88 { transition-duration: 88.0s; }
.TimerFill.span-89 { transition-duration: 89.0s; }
.TimerFill.span-90 { transition-duration: 90.0s; }
/* END span-ladder */

.TimerFill.is-running
{
	clip: rect( 0%, 0%, 100%, 0% );
}

/* The reveal drains a fresh panel: reversing a still-running drain would refill at the old pace. */
.TimerFillReveal,
.VoteRoot.view-reveal .TimerFill
{
	visibility: collapse;
}

.VoteRoot.view-reveal .TimerFillReveal
{
	visibility: visible;
}

@keyframes 'mv-urgent'
{
	0% { opacity: 1.0; }
	50% { opacity: 0.55; }
	100% { opacity: 1.0; }
}

.Timer.is-urgent .TimerText
{
	color: #e05a5a;
	opacity: 1.0;
	animation-name: 'mv-urgent';
	animation-duration: 1.0s;
	animation-timing-function: ease-in-out;
	animation-iteration-count: infinite;
}

.Timer.is-urgent .TimerFill
{
	background-color: #e05a5a;
}

.HideBtn
{
	width: fit-children;
	height: 40px;
	horizontal-align: right;
	vertical-align: middle;
	flow-children: none;
	padding: 0px 16px 0px 16px;
	background-color: #0b0f14e0;
	border: 1px solid #ffffff33;
	border-radius: 3px;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.HideBtn:hover
{
	background-color: #ffffff1c;
	sound: "UIPanorama.generic_button_rollover";
}

.HideBtn:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.HideLabel
{
	width: fit-children;
	horizontal-align: center;
	vertical-align: middle;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #f5f7fa;
	white-space: nowrap;
}

/* ---- Body ---- */

.VoteBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	transition-property: opacity;
	transition-duration: 0.25s;
}

.StatusLine
{
	width: 100%;
	height: 32px;
	flow-children: right;
	padding: 0px 24px 0px 24px;
}

.CheckIcon
{
	width: 18px;
	height: 18px;
	horizontal-align: center;
	vertical-align: middle;
	background-image: url( "s2r://panorama/images/icons/ui/check.svg" );
	background-size: 18px 18px;
	background-repeat: no-repeat;
}

.StatusCheck
{
	margin-right: 8px;
	visibility: collapse;
	wash-color: #f0a531;
}

.StatusLine.is-self .StatusCheck
{
	visibility: visible;
}

.StatusText
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-family: Stratum2 Bold Condensed;
	font-size: 20;
	letter-spacing: 0.5px;
	color: #a3acb6;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.StatusLine.is-self .StatusText
{
	color: #f5f7fa;
}

.HeadRow
{
	width: 100%;
	height: 276px;
	flow-children: right;
	padding: 0px 24px 0px 24px;
	margin-top: 8px;
}

/* ---- Current map card + rating ---- */

.CurrentCard
{
	width: 608px;
	height: 100%;
	flow-children: right;
	margin-right: 16px;
	padding: 12px 16px 12px 16px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #12171ee8 ), to( #0b0f14f2 ) );
	border: 1px solid #ffffff14;
	border-radius: 4px;
}

.CurrentCard.is-off
{
	visibility: collapse;
}

.CurrentInfo
{
	width: 256px;
	height: 100%;
	flow-children: down;
}

.CurrentHead
{
	width: 100%;
	height: 32px;
	flow-children: none;
	margin-bottom: 4px;
}

.CardTag
{
	width: fit-children;
	horizontal-align: left;
	vertical-align: middle;
	font-family: Stratum2 Bold Condensed;
	font-size: 16;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #a3acb6;
}

.CurrentImage
{
	width: 256px;
	height: 144px;
	flow-children: none;
	overflow: clip;
	border-radius: 3px;
}

.CurrentImage .MapShot
{
	background-size: 256px 144px;
}

.CurrentName
{
	width: 100%;
	margin-top: 8px;
	font-family: Stratum2 Bold Condensed;
	font-size: 22;
	color: #f5f7fa;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.RateArea
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
	margin-left: 16px;
	transition-property: opacity;
	transition-duration: 0.25s;
}

.RateQuestion
{
	width: 100%;
	height: 32px;
	margin-bottom: 4px;
	padding-top: 6px;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	color: #e8eef4;
}

.RateBtn
{
	width: 100%;
	height: 44px;
	flow-children: right;
	margin-bottom: 8px;
	padding: 0px 12px 0px 12px;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.RateBtn:hover
{
	background-color: #ffffff1c;
	sound: "UIPanorama.generic_button_rollover";
}

.RateBtn:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.RateIcon
{
	width: 24px;
	height: 24px;
	vertical-align: middle;
	margin-right: 12px;
	background-size: 24px 24px;
	background-repeat: no-repeat;
	wash-color: #e8eef4;
}

/* Stock CS2 icon; dislike is the same thumb turned upside down. */
.ico-like
{
	background-image: url( "s2r://panorama/images/icons/ui/thumbs_up.vsvg" );
}

.ico-dislike
{
	background-image: url( "s2r://panorama/images/icons/ui/thumbs_up.vsvg" );
	transform: rotateZ( 180deg );
}

.RateLabel
{
	width: fill-parent-flow( 1.0 );
	vertical-align: middle;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #f5f7fa;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.RateCount
{
	width: fit-children;
	vertical-align: middle;
	margin-left: 8px;
	font-family: Stratum2 Bold Condensed;
	font-size: 20;
	color: #f5f7fa;
}

.RateCheck
{
	width: 18px;
	height: 18px;
	vertical-align: middle;
	margin-left: 8px;
	background-image: url( "s2r://panorama/images/icons/ui/check.svg" );
	background-size: 18px 18px;
	background-repeat: no-repeat;
	visibility: collapse;
}

/* Selected: colour surface + check (U13: a dislike never reads like a like). */
.LikeBtn.is-active
{
	background-color: #9ccf4f33;
	border: 1px solid #9ccf4f;
}

.LikeBtn.is-active:hover
{
	background-color: #9ccf4f4d;
}

.DislikeBtn.is-active
{
	background-color: #e05a5a33;
	border: 1px solid #e05a5a;
}

.DislikeBtn.is-active:hover
{
	background-color: #e05a5a4d;
}

.LikeBtn.is-active .RateIcon,
.LikeBtn.is-active .RateCheck
{
	wash-color: #9ccf4f;
}

.DislikeBtn.is-active .RateIcon,
.DislikeBtn.is-active .RateCheck
{
	wash-color: #e05a5a;
}

.RateBtn.is-active .RateCheck
{
	visibility: visible;
}

.RateArea.is-disabled .RateBtn
{
	opacity: 0.35;
	cursor: default;
}

.RateArea.is-disabled .RateBtn:hover,
.RateArea.is-disabled .RateBtn:active
{
	background-color: #ffffff0d;
	sound: "";
}

/* ---- Ranking ---- */

.Ranking
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
	flow-children: down;
	padding: 8px 16px 8px 16px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #12171ee8 ), to( #0b0f14f2 ) );
	border: 1px solid #ffffff14;
	border-radius: 4px;
}

.RankTitle
{
	width: 100%;
	height: 28px;
	padding-top: 4px;
	font-family: Stratum2 Bold Condensed;
	font-size: 16;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #a3acb6;
}

/* Empty state keeps the frame; no scroll panel here, so no scrollbar (U14). */
.RankEmpty
{
	width: 100%;
	margin-top: 76px;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 22;
	color: #a3acb6;
}

.RankEmpty.is-off
{
	visibility: collapse;
}

.RankRow
{
	width: 100%;
	height: 36px;
	flow-children: none;
	margin-bottom: 4px;
	background-color: #ffffff0d;
	border-radius: 3px;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.RankRow.is-off
{
	visibility: collapse;
}

.RankRow:hover
{
	background-color: #ffffff1c;
	sound: "UIPanorama.generic_button_rollover";
}

.RankRow:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.RankSelf
{
	width: 100%;
	height: 100%;
	flow-children: none;
	border-radius: 3px;
}

.RankSelf.is-self
{
	background-color: #f0a53122;
	border: 1px solid #f0a531;
}

.RankSelfMark
{
	width: fit-children;
	height: 100%;
	horizontal-align: right;
	flow-children: right;
	margin-right: 12px;
	visibility: collapse;
}

.RankSelf.is-self .RankSelfMark
{
	visibility: visible;
}

.RankSelfMark .CheckIcon
{
	margin-right: 6px;
	wash-color: #ffd27a;
}

.RankSelfLabel
{
	width: fit-children;
	vertical-align: middle;
	font-family: Stratum2 Bold Condensed;
	font-size: 16;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #ffd27a;
	white-space: nowrap;
}

.RankLine
{
	width: 100%;
	height: 100%;
	flow-children: right;
}

.RankPos
{
	width: 32px;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	color: #a3acb6;
}

.RankImage
{
	width: 64px;
	height: 36px;
	flow-children: none;
	overflow: clip;
}

.RankImage .MapShot
{
	background-size: 64px 36px;
}

.RankName
{
	width: 280px;
	vertical-align: middle;
	margin-left: 12px;
	font-family: Stratum2 Bold Condensed;
	font-size: 20;
	color: #f5f7fa;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.RankTrack
{
	width: fill-parent-flow( 1.0 );
	height: 10px;
	vertical-align: middle;
	margin-left: 12px;
	overflow: clip;
	background-color: #ffffff12;
	border-radius: 5px;
}

.RankFill
{
	width: 100%;
	height: 100%;
	background-color: #f0a531;
	transition-property: clip;
	transition-duration: 0.35s;
	transition-timing-function: ease-out;
}

/* BEGIN share-ladder */
.RankFill.p0 { clip: rect( 0%, 0%, 100%, 0% ); }
.RankFill.p10 { clip: rect( 0%, 10%, 100%, 0% ); }
.RankFill.p20 { clip: rect( 0%, 20%, 100%, 0% ); }
.RankFill.p30 { clip: rect( 0%, 30%, 100%, 0% ); }
.RankFill.p40 { clip: rect( 0%, 40%, 100%, 0% ); }
.RankFill.p50 { clip: rect( 0%, 50%, 100%, 0% ); }
.RankFill.p60 { clip: rect( 0%, 60%, 100%, 0% ); }
.RankFill.p70 { clip: rect( 0%, 70%, 100%, 0% ); }
.RankFill.p80 { clip: rect( 0%, 80%, 100%, 0% ); }
.RankFill.p90 { clip: rect( 0%, 90%, 100%, 0% ); }
.RankFill.p100 { clip: rect( 0%, 100%, 100%, 0% ); }
/* END share-ladder */

.RankVotes
{
	width: 48px;
	vertical-align: middle;
	text-align: right;
	font-family: Stratum2 Bold Condensed;
	font-size: 20;
	color: #f5f7fa;
}

.RankSelfGap
{
	width: 168px;
	height: 100%;
}

/* ---- Filters ---- */

.FilterBar
{
	width: 100%;
	height: fit-children;
	flow-children: down;
	margin-top: 12px;
	padding: 0px 24px 0px 24px;
	z-index: 5;
	background-color: #00000001;
	transition-property: opacity;
	transition-duration: 0.25s;
}

.FilterBar.is-off
{
	visibility: collapse;
}

.FilterRow,
.SortRow
{
	width: 100%;
	height: 40px;
	flow-children: right;
}

.SortRow
{
	margin-top: 4px;
	visibility: collapse;
}

.FilterGap
{
	width: fill-parent-flow( 1.0 );
	height: 100%;
}

.FilterChip
{
	width: fit-children;
	height: 36px;
	vertical-align: middle;
	flow-children: right;
	margin-right: 8px;
	padding: 0px 14px 0px 14px;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.FilterChip.is-off
{
	visibility: collapse;
}

.FilterChip:hover
{
	background-color: #ffffff1c;
	sound: "UIPanorama.generic_button_rollover";
}

.FilterChip:active
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_press";
}

.FilterChip.is-active
{
	background-color: #f0a53122;
	border: 1px solid #f0a531;
}

.FilterChip.is-active:hover
{
	background-color: #f0a53144;
}

/* Declared after hover/active so it neutralises them without :not(). */
.FilterChip.is-disabled,
.FilterChip.is-disabled:hover,
.FilterChip.is-disabled:active
{
	opacity: 0.35;
	background-color: #ffffff0d;
	cursor: default;
	sound: "";
}

.ChipLabel
{
	width: fit-children;
	vertical-align: middle;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	white-space: nowrap;
}

.FilterChip.is-active .ChipLabel
{
	color: #ffd27a;
}

.FavChip
{
	margin-right: 0px;
}

.FavChip .FavIcon
{
	margin-right: 8px;
}

.FavIcon
{
	width: 18px;
	height: 18px;
	horizontal-align: center;
	vertical-align: middle;
	background-image: url( "s2r://panorama/images/icons/ui/favorite_no.vsvg" );
	background-size: 18px 18px;
	background-repeat: no-repeat;
}

.FavBtn.is-active .FavIcon,
.FavChip.is-active .FavIcon
{
	background-image: url( "s2r://panorama/images/icons/ui/favorite_yes.vsvg" );
}

/* ---- Grid: only this part scrolls ---- */

.GridHost
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: none;
	margin-top: 8px;
	z-index: 1;
}

.MapCatalog
{
	width: 100%;
	height: 100%;
	flow-children: right-wrap;
	overflow: squish scroll;
	padding: 2px 18px 56px 18px;
	background-color: #00000001;
	transition-property: opacity;
	transition-duration: 0.25s;
}

.MapSlot
{
	width: 186px;
	height: 141px;
	flow-children: none;
	margin: 5px 5px 5px 5px;
	background-color: #00000001;
}

.MapSlot.is-off
{
	visibility: collapse;
}

.MapCard
{
	width: 100%;
	height: 100%;
	flow-children: down;
	background-color: #0b0f14f2;
	border-radius: 3px;
	overflow: clip;
	wash-color: none;
	brightness: 1.0;
	transition-property: brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.MapCard:hover
{
	brightness: 1.2;
	sound: "UIPanorama.submenu_contents_rollover";
}

.MapCard:active
{
	brightness: 0.9;
	sound: "UIPanorama.submenu_select";
}

/* Full 16:9 shot, uncropped (U8). 186 + 2 x 5 margin = 196 pitch: 7 columns at 4:3, 9 at 16:9. */
.CardImage
{
	width: 186px;
	height: 105px;
	flow-children: none;
}

.MapShot
{
	width: 100%;
	height: 100%;
	background-repeat: no-repeat;
}

.CardImage .MapShot
{
	background-size: 186px 105px;
}

/* Votes only when > 0 (U7). */
.VoteBadge
{
	width: fit-children;
	height: 28px;
	horizontal-align: right;
	vertical-align: bottom;
	margin: 0px 6px 6px 0px;
	padding: 2px 8px 0px 8px;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	color: #f5f7fa;
	background-color: #0b0f14e8;
	border-radius: 3px;
	visibility: collapse;
}

.MapCard.votes-some .VoteBadge
{
	visibility: visible;
}

.SelfBadge
{
	width: 28px;
	height: 28px;
	horizontal-align: left;
	vertical-align: top;
	margin: 6px 0px 0px 6px;
	flow-children: none;
	background-color: #0b0f14e8;
	border: 2px solid #f0a531;
	border-radius: 14px;
	visibility: collapse;
}

.SelfBadge .CheckIcon
{
	wash-color: #ffd27a;
}

.MapSlot.is-self .SelfBadge
{
	visibility: visible;
	flow-children: none;
}

/* Name in its own bar under the shot: long names fit or ellipsize (U12). */
.CardName
{
	width: 100%;
	height: 36px;
	padding: 6px 8px 0px 8px;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	color: #f5f7fa;
	text-overflow: ellipsis;
	white-space: nowrap;
}

/* Frame as an overlay sibling so a thicker border never crops the 192x108 shot. */
.CardFrame
{
	width: 100%;
	height: 100%;
	border: 1px solid #ffffff14;
	border-radius: 3px;
}

/* Own vote: accent frame (with the check badge and the status text). */
.MapSlot.is-self .CardFrame
{
	border: 2px solid #f0a531;
}

.MapSlot.is-self .CardName
{
	color: #ffd27a;
}

/* Favourite toggle: outline star only on hover, filled star always. */
.CardFav
{
	width: 28px;
	height: 28px;
	horizontal-align: right;
	vertical-align: top;
	margin: 6px 6px 0px 0px;
	flow-children: none;
	background-color: #0b0f14cc;
	border-radius: 3px;
	wash-color: none;
	opacity: 0.0;
	transition-property: opacity, background-color;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.MapSlot:hover .CardFav,
.CardFav.is-active
{
	opacity: 1.0;
}

.CardFav:hover,
.CurrentFav:hover
{
	background-color: #ffffff2e;
	sound: "UIPanorama.generic_button_rollover";
}

.CardFav:active,
.CurrentFav:active
{
	background-color: #ffffff44;
	sound: "UIPanorama.generic_button_press";
}

.CurrentFav
{
	width: 32px;
	height: 32px;
	horizontal-align: right;
	vertical-align: middle;
	flow-children: none;
	background-color: #ffffff0d;
	border-radius: 3px;
	wash-color: none;
	transition-property: background-color;
	transition-duration: 0.15s;
}

/* Static hint that the grid continues (the server never knows the scroll position). */
.GridFade
{
	width: 100%;
	height: 56px;
	vertical-align: bottom;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #0b0f1400 ), to( #0b0f14e6 ) );
}

.MapEmpty
{
	width: 100%;
	vertical-align: top;
	margin-top: 48px;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 22;
	color: #a3acb6;
}

.MapEmpty.is-off
{
	visibility: collapse;
}

/* ---- Reveal view ---- */

@keyframes 'mv-reveal-in'
{
	0% { opacity: 0.0; transform: translateY( 16px ); }
	100% { opacity: 1.0; transform: translateY( 0px ); }
}

.RevealCard
{
	width: 600px;
	height: fit-children;
	horizontal-align: center;
	vertical-align: middle;
	flow-children: down;
	padding: 20px 24px 20px 24px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #12171ef2 ), to( #0b0f14fa ) );
	border: 2px solid #9ccf4f;
	border-radius: 6px;
	visibility: collapse;
}

.RevealTag
{
	width: 100%;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 20;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #9ccf4f;
}

.RevealImage
{
	width: 552px;
	height: 311px;
	flow-children: none;
	margin-top: 12px;
	overflow: clip;
	border-radius: 3px;
}

.RevealImage .MapShot
{
	background-size: 552px 311px;
}

.RevealName
{
	width: 100%;
	margin-top: 12px;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 44;
	color: #f5f7fa;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.RevealVotes
{
	width: 100%;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 22;
	color: #e8eef4;
}

/* Resting state = last keyframe, so it holds even if fill-mode is ignored. */
.VoteRoot.view-reveal .RevealCard
{
	visibility: visible;
	flow-children: down;
	opacity: 1.0;
	transform: translateY( 0px );
	animation-name: 'mv-reveal-in';
	animation-duration: 0.25s;
	animation-timing-function: ease-out;
}

.VoteRoot.view-reveal .MapCatalog
{
	opacity: 0.25;
}

.VoteRoot.view-reveal .FilterBar,
.VoteRoot.view-reveal .RateArea
{
	opacity: 0.35;
}

.VoteRoot.view-reveal .RateBtn:hover,
.VoteRoot.view-reveal .RateBtn:active,
.VoteRoot.view-reveal .FilterChip:hover,
.VoteRoot.view-reveal .FilterChip:active
{
	background-color: #ffffff0d;
	cursor: default;
	sound: "";
}

/* ---- Browse view (!maps): no timer, no ranking, sort chips shown ---- */

.VoteRoot.view-browse .Timer,
.VoteRoot.view-browse .Ranking,
.VoteRoot.view-browse .StatusCheck,
.VoteRoot.view-browse .VoteBadge,
.VoteRoot.view-browse .SelfBadge
{
	visibility: collapse;
}

.VoteRoot.view-browse .SortRow
{
	visibility: visible;
}

/* ---- Minimized: timer + button stay; body keeps its tree mounted (repeat collapse crashed v1) ---- */

.VoteRoot.is-minimized .mv-glass,
.VoteRoot.is-minimized .mv-scrim,
.VoteRoot.is-minimized .VoteTitle,
.VoteRoot.is-minimized .CreditBar
{
	opacity: 0.0;
}

.VoteRoot.is-minimized .VoteBody
{
	height: 0px;
	opacity: 0.0;
	overflow: clip;
}

.VoteRoot.is-minimized .MapCard,
.VoteRoot.is-minimized .FavBtn,
.VoteRoot.is-minimized .RateBtn,
.VoteRoot.is-minimized .RankRow,
.VoteRoot.is-minimized .FilterChip
{
	visibility: collapse;
}

.VoteRoot.is-minimized .Timer
{
	background-color: #0b0f14e0;
}

.VoteRoot.is-minimized .HideBtn
{
	border: 1px solid #f0a531;
}

.VoteRoot.is-minimized .HideLabel
{
	color: #ffd27a;
}

/* ---- Credit ---- */

.CreditBar
{
	width: 100%;
	height: 28px;
	flow-children: none;
	background-color: #0b0f14f2;
	transition-property: opacity;
	transition-duration: 0.25s;
}

.CreditLabel
{
	width: fit-children;
	horizontal-align: center;
	vertical-align: middle;
	font-family: Stratum2 Bold Condensed;
	font-size: 14;
	letter-spacing: 1px;
	color: #a3acb6;
	white-space: nowrap;
}
