.VotedStrip.vw-47 { width: 5922px; }
.VotedStrip.vw-48 { width: 6048px; }
.VotedStrip.vw-49 { width: 6174px; }
.VotedStrip.vw-50 { width: 6300px; }
.VotedStrip.vw-51 { width: 6426px; }
.VotedStrip.vw-52 { width: 6552px; }
.VotedStrip.vw-53 { width: 6678px; }
.VotedStrip.vw-54 { width: 6804px; }
.VotedStrip.vw-55 { width: 6930px; }
