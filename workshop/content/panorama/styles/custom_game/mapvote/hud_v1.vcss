/* MapVote HUD - CS2 end-of-match vote (ruleset-safe).
   Contract: vote_v1.xml / VoteIds.cs  Palette: surface #12171ee8→#0b0f14f2, accent #ff9a1a
   Deviation: background-position 50% 50% on .MapShot only - centers the 350×197 cover crop (§5.1). */

.HudScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

.VoteRoot
{
	width: 100%;
	height: 100%;
	flow-children: none;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.VoteRoot.is-fading
{
	opacity: 0.0;
	transition-duration: 0.5s;
	transition-timing-function: ease-in;
}

.VoteRoot.is-off
{
	visibility: collapse;
}

.mv-glass
{
	width: 100%;
	height: 100%;
	background-color: #0000000d;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

/* One pass: top vignette plus a darker foot. Replaces two fullscreen gradients. */
.mv-scrim
{
	width: 100%;
	height: 100%;
	/* Top two stops at 70% of prior alpha so the victory splash stays readable. */
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #0000009d ), color-stop( 0.22, #00000061 ), color-stop( 0.5, #00000070 ), color-stop( 0.78, #00000078 ), to( #000000a0 ) );
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.VoteColumn
{
	width: 100%;
	height: 100%;
	flow-children: down;
}

.VoteTopBar
{
	width: 100%;
	height: 50px;
	flow-children: none;
}

.VoteTitle
{
	/* Line box matches font-size so vertical-align: middle centers glyphs in the bar. */
	width: 100%;
	height: 22px;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 22;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #ffffff;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.MinimizeBtn
{
	width: fit-children;
	height: 28px;
	horizontal-align: right;
	vertical-align: middle;
	margin-right: 16px;
	padding-left: 12px;
	padding-right: 12px;
	background-color: #00000099;
	border: 1px solid #ffffff33;
	border-radius: 3px;
	flow-children: none;
	wash-color: none;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.MinimizeBtn:hover
{
	background-color: #ffffff22;
	brightness: 1.1;
	sound: "UIPanorama.generic_button_rollover";
}

.MinimizeBtn:active
{
	brightness: 0.85;
	sound: "UIPanorama.generic_button_press";
}

.MinimizeLabel
{
	width: fit-children;
	height: 15px;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 15;
	letter-spacing: 1.2px;
	text-transform: uppercase;
	color: #ffffff;
	white-space: nowrap;
}

/* Tuck: fade surfaces; keep scroll/flow trees mounted (repeat collapse crashes the layout). */
.VoteRoot.is-minimized .mv-glass,
.VoteRoot.is-minimized .mv-scrim,
.VoteRoot.is-minimized .VoteTitle,
.VoteRoot.is-minimized .CreditBar
{
	opacity: 0.0;
}

.VoteRoot.is-minimized .VoteBody,
.VoteRoot.is-minimized .MapGridHost
{
	height: 0px;
	padding-top: 0px;
	opacity: 0.0;
	overflow: clip;
}

.VoteRoot.is-minimized .MapTile,
.VoteRoot.is-minimized .FavBtn,
.VoteRoot.is-minimized .FilterChip
{
	visibility: collapse;
}

.VoteRoot.is-minimized .MinimizeBtn
{
	background-color: #000000cc;
	border: 1px solid #ff9a1a;
}

.VoteRoot.is-minimized .MinimizeLabel
{
	color: #ff9a1a;
}

.VoteBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	padding-top: 12px;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.VotedSection
{
	width: 100%;
	flow-children: down;
	padding-top: 8px;
	padding-bottom: 12px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000b3 ), to( #00000066 ) );
	border-bottom: 1px solid #ffffff14;
}

.VotedSection.has-votes
{
	border-bottom: 2px solid #ff9a1a;
}

.VotedRow
{
	width: 100%;
	height: 213px;
	overflow: scroll clip;
	flow-children: none;
	horizontal-align: center;
}

.VotedHint
{
	width: 100%;
	horizontal-align: center;
	vertical-align: bottom;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 42;
	color: #a3acb6;
	letter-spacing: 1px;
	text-transform: uppercase;
	z-index: 1;
}

.VotedHint.is-off
{
	visibility: collapse;
}

.VotedStrip
{
	height: 213px;
	flow-children: right;
	overflow: noclip noclip;
	horizontal-align: center;
	vertical-align: middle;
	/* Near-invisible fill so wheel hits gutters between tiles. */
	background-color: #00000001;
}

/* Slot pitch = 110px tile + 8px + 8px margin = 126px */
/* BEGIN vw-ladder */
.VotedStrip.vw-0 { width: 0px; }
.VotedStrip.vw-1 { width: 126px; }
.VotedStrip.vw-2 { width: 252px; }
.VotedStrip.vw-3 { width: 378px; }
.VotedStrip.vw-4 { width: 504px; }
.VotedStrip.vw-5 { width: 630px; }
.VotedStrip.vw-6 { width: 756px; }
.VotedStrip.vw-7 { width: 882px; }
.VotedStrip.vw-8 { width: 1008px; }
.VotedStrip.vw-9 { width: 1134px; }
.VotedStrip.vw-10 { width: 1260px; }
.VotedStrip.vw-11 { width: 1386px; }
.VotedStrip.vw-12 { width: 1512px; }
.VotedStrip.vw-13 { width: 1638px; }
.VotedStrip.vw-14 { width: 1764px; }
.VotedStrip.vw-15 { width: 1890px; }
.VotedStrip.vw-16 { width: 2016px; }
.VotedStrip.vw-17 { width: 2142px; }
.VotedStrip.vw-18 { width: 2268px; }
.VotedStrip.vw-19 { width: 2394px; }
.VotedStrip.vw-20 { width: 2520px; }
.VotedStrip.vw-21 { width: 2646px; }
.VotedStrip.vw-22 { width: 2772px; }
.VotedStrip.vw-23 { width: 2898px; }
.VotedStrip.vw-24 { width: 3024px; }
.VotedStrip.vw-25 { width: 3150px; }
.VotedStrip.vw-26 { width: 3276px; }
.VotedStrip.vw-27 { width: 3402px; }
.VotedStrip.vw-28 { width: 3528px; }
.VotedStrip.vw-29 { width: 3654px; }
.VotedStrip.vw-30 { width: 3780px; }
.VotedStrip.vw-31 { width: 3906px; }
.VotedStrip.vw-32 { width: 4032px; }
.VotedStrip.vw-33 { width: 4158px; }
.VotedStrip.vw-34 { width: 4284px; }
.VotedStrip.vw-35 { width: 4410px; }
.VotedStrip.vw-36 { width: 4536px; }
.VotedStrip.vw-37 { width: 4662px; }
.VotedStrip.vw-38 { width: 4788px; }
.VotedStrip.vw-39 { width: 4914px; }
.VotedStrip.vw-40 { width: 5040px; }
.VotedStrip.vw-41 { width: 5166px; }
.VotedStrip.vw-42 { width: 5292px; }
.VotedStrip.vw-43 { width: 5418px; }
.VotedStrip.vw-44 { width: 5544px; }
.VotedStrip.vw-45 { width: 5670px; }
.VotedStrip.vw-46 { width: 5796px; }
.VotedStrip.vw-47 { width: 5922px; }
.VotedStrip.vw-48 { width: 6048px; }
.VotedStrip.vw-49 { width: 6174px; }
.VotedStrip.vw-50 { width: 6300px; }
.VotedStrip.vw-51 { width: 6426px; }
.VotedStrip.vw-52 { width: 6552px; }
.VotedStrip.vw-53 { width: 6678px; }
.VotedStrip.vw-54 { width: 6804px; }
.VotedStrip.vw-55 { width: 6930px; }
.VotedStrip.vw-56 { width: 7056px; }
.VotedStrip.vw-57 { width: 7182px; }
.VotedStrip.vw-58 { width: 7308px; }
.VotedStrip.vw-59 { width: 7434px; }
.VotedStrip.vw-60 { width: 7560px; }
.VotedStrip.vw-61 { width: 7686px; }
.VotedStrip.vw-62 { width: 7812px; }
.VotedStrip.vw-63 { width: 7938px; }
.VotedStrip.vw-64 { width: 8064px; }
.VotedStrip.vw-65 { width: 8190px; }
.VotedStrip.vw-66 { width: 8316px; }
.VotedStrip.vw-67 { width: 8442px; }
.VotedStrip.vw-68 { width: 8568px; }
.VotedStrip.vw-69 { width: 8694px; }
.VotedStrip.vw-70 { width: 8820px; }
.VotedStrip.vw-71 { width: 8946px; }
.VotedStrip.vw-72 { width: 9072px; }
.VotedStrip.vw-73 { width: 9198px; }
.VotedStrip.vw-74 { width: 9324px; }
.VotedStrip.vw-75 { width: 9450px; }
.VotedStrip.vw-76 { width: 9576px; }
.VotedStrip.vw-77 { width: 9702px; }
.VotedStrip.vw-78 { width: 9828px; }
.VotedStrip.vw-79 { width: 9954px; }
.VotedStrip.vw-80 { width: 10080px; }
.VotedStrip.vw-81 { width: 10206px; }
.VotedStrip.vw-82 { width: 10332px; }
.VotedStrip.vw-83 { width: 10458px; }
.VotedStrip.vw-84 { width: 10584px; }
.VotedStrip.vw-85 { width: 10710px; }
.VotedStrip.vw-86 { width: 10836px; }
.VotedStrip.vw-87 { width: 10962px; }
.VotedStrip.vw-88 { width: 11088px; }
.VotedStrip.vw-89 { width: 11214px; }
.VotedStrip.vw-90 { width: 11340px; }
.VotedStrip.vw-91 { width: 11466px; }
.VotedStrip.vw-92 { width: 11592px; }
.VotedStrip.vw-93 { width: 11718px; }
.VotedStrip.vw-94 { width: 11844px; }
.VotedStrip.vw-95 { width: 11970px; }
.VotedStrip.vw-96 { width: 12096px; }
.VotedStrip.vw-97 { width: 12222px; }
.VotedStrip.vw-98 { width: 12348px; }
.VotedStrip.vw-99 { width: 12474px; }
.VotedStrip.vw-100 { width: 12600px; }
/* END vw-ladder */

.FilterBar
{
	/* Hit-enabled (no hittest=false) + above MapGridHost so scrolled tiles cannot steal chip clicks. */
	width: fit-children;
	height: 36px;
	flow-children: right;
	horizontal-align: center;
	vertical-align: middle;
	padding-left: 12px;
	padding-right: 12px;
	margin-bottom: 4px;
	z-index: 5;
	/* Near-invisible fill so the bar itself receives hits between chips. */
	background-color: #00000001;
}

.FilterBar.is-off
{
	visibility: collapse;
}

.FilterTypeRow,
.FilterSortRow
{
	height: 36px;
	flow-children: right;
	vertical-align: middle;
}

.FilterSortRow
{
	margin-left: 16px;
}

.FilterChip
{
	width: fit-children;
	height: 28px;
	padding-left: 12px;
	padding-right: 12px;
	margin-right: 8px;
	vertical-align: middle;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
	flow-children: none;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
	wash-color: none;
}

.FilterChip.is-off
{
	visibility: collapse;
}

.FilterChip.is-disabled
{
	opacity: 0.35;
	cursor: default;
}

.FilterChip:not(.is-disabled):hover
{
	background-color: #ffffff1c;
	sound: "UIPanorama.generic_button_rollover";
}

.FilterChip:not(.is-disabled):active
{
	background-color: #ffffff2e;
	brightness: 0.9;
	sound: "UIPanorama.generic_button_press";
}

.FilterChip.is-disabled:hover,
.FilterChip.is-disabled:active
{
	background-color: #ffffff0d;
	brightness: 1.0;
	sound: "";
}

.FilterChip.is-active
{
	background-color: #ff9a1a22;
	border: 1px solid #ff9a1a;
}

.FilterChip.is-active:not(.is-disabled):hover
{
	background-color: #ff9a1a44;
}

.FilterChipLabel
{
	width: fit-children;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 15;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	white-space: nowrap;
}

.FilterChip.is-active .FilterChipLabel
{
	color: #ffd27a;
}

.MapGridHost
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: none;
	z-index: 1;
	overflow: clip;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.MapGrid
{
	width: 100%;
	height: 100%;
	overflow: squish scroll;
	flow-children: down;
}

.MapEmpty
{
	width: 100%;
	height: 36px;
	horizontal-align: center;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #a3acb6;
	margin-top: 24px;
}

.MapEmpty.is-off
{
	visibility: collapse;
}

.MapCatalog
{
	width: 100%;
	flow-children: down;
	overflow: noclip noclip;
	horizontal-align: center;
	padding-left: 12px;
	padding-right: 12px;
}

/* BEGIN rows-ladder */
.MapCatalog.rows-0 { height: 0px; }
.MapCatalog.rows-1 { height: 213px; }
.MapCatalog.rows-2 { height: 426px; }
.MapCatalog.rows-3 { height: 639px; }
.MapCatalog.rows-4 { height: 852px; }
.MapCatalog.rows-5 { height: 1065px; }
.MapCatalog.rows-6 { height: 1278px; }
.MapCatalog.rows-7 { height: 1491px; }
.MapCatalog.rows-8 { height: 1704px; }
.MapCatalog.rows-9 { height: 1917px; }
.MapCatalog.rows-10 { height: 2130px; }
/* END rows-ladder */

.CatalogRow
{
	height: 213px;
	flow-children: right;
	horizontal-align: center;
	/* Near-invisible fill so wheel hits gutters between tiles. */
	background-color: #00000001;
}

/* BEGIN cols-ladder */
.CatalogRow.cols-0 { width: 0%; }
.CatalogRow.cols-1 { width: 18%; }
.CatalogRow.cols-2 { width: 36%; }
.CatalogRow.cols-3 { width: 54%; }
.CatalogRow.cols-4 { width: 72%; }
.CatalogRow.cols-5 { width: 90%; }
.CatalogRow.cols-6 { width: 100%; }
/* END cols-ladder */

.CatalogRow.is-off
{
	visibility: collapse;
}

.MapSlot
{
	width: 110px;
	height: 213px;
	horizontal-align: center;
	flow-children: none;
	margin: 0px 8px 0px 8px;
	/* Near-invisible fill so wheel hits gutters between tiles. */
	background-color: #00000001;
}

.CatalogRow .MapSlot
{
	width: fill-parent-flow( 1.0 );
}

.MapSlot.is-off
{
	visibility: collapse;
}

.MapTile
{
	width: 100%;
	height: 193px;
	vertical-align: middle;
	border: 0px solid #00000000;
	box-shadow: none;
	wash-color: none;
	overflow: clip;
	flow-children: none;
	transition-property: brightness;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

.MapTile.is-self
{
	border: 2px solid #ffffff;
	box-shadow: #ffffff 0px 0px 6px 0px;
}

.MapTile.is-lost
{
	wash-color: #000000;
	brightness: 0.55;
	border: 0px solid #00000000;
	box-shadow: none;
	transition-property: wash-color, brightness;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.MapTile:hover
{
	sound: "UIPanorama.submenu_contents_rollover";
}

.MapTile:active
{
	sound: "UIPanorama.submenu_select";
}

.MapTile.is-lost:hover .MapShot
{
	transform: scale3d( 1.0, 1.0, 1.0 );
}

.MapShot
{
	width: 100%;
	height: 100%;
	z-index: 0;
	transform: scale3d( 1.0, 1.0, 1.0 );
	background-repeat: no-repeat;
	background-size: 350px 197px;
	background-position: 50% 50%;
	transition-property: transform;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

.MapTile:hover .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

.MapTile.is-self .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

.MapFade
{
	width: 100%;
	height: 100%;
	z-index: 1;
	/* Clear through mid-tile; shadow ramps below for vote count + name. */
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #00000000 ), color-stop( 0.5, #00000000 ), color-stop( 0.7, #000000aa ), to( #000000ff ) );
}

.MapVotes
{
	width: 100%;
	z-index: 2;
	vertical-align: bottom;
	horizontal-align: center;
	margin: 0px;
	margin-bottom: 40px;
	font-family: Stratum2;
	font-size: 29;
	color: #ff9a1a;
	text-align: center;
}

.MapName
{
	width: 90%;
	height: 36px;
	z-index: 2;
	margin: 0px 4px 6px 4px;
	vertical-align: bottom;
	horizontal-align: center;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	color: #ffffff;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.FavBtn
{
	width: 28px;
	height: 28px;
	horizontal-align: right;
	vertical-align: top;
	/* MapTile is 193px centered in 213px MapSlot → 10px top gap; +4px inset. */
	margin-top: 14px;
	margin-right: 4px;
	/* Above MapTile / MapFade (z 0–3). */
	z-index: 4;
	flow-children: none;
	wash-color: none;
	background-color: #00000066;
	border-radius: 3px;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.FavBtn:hover
{
	background-color: #00000099;
	brightness: 1.1;
	sound: "UIPanorama.generic_button_rollover";
}

.FavBtn:active
{
	brightness: 0.85;
	sound: "UIPanorama.generic_button_press";
}

.FavIcon
{
	width: 20px;
	height: 20px;
	horizontal-align: center;
	vertical-align: middle;
	background-image: url( "s2r://panorama/images/icons/ui/favorite_no.vsvg" );
	background-size: 20px 20px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
}

.FavBtn.is-on .FavIcon
{
	background-image: url( "s2r://panorama/images/icons/ui/favorite_yes.vsvg" );
}

@keyframes 'mv-winner-pulse'
{
	0%
	{
		border: 2px solid #ffffff00;
	}

	50%
	{
		border: 5px solid #ffff00;
	}

	100%
	{
		border: 2px solid #ffffff;
	}
}

.MapTile.is-done
{
	wash-color: none;
	brightness: 1.0;
	border: 2px solid #ffffff;
	box-shadow: #ffffff 0px 0px 6px 0px;
	animation-name: 'mv-winner-pulse';
	animation-duration: 0.5s;
	animation-timing-function: ease-out;
	animation-iteration-count: 1;
}

.MapTile.is-done .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

.MapWinnerCheck
{
	width: 50px;
	height: 50px;
	z-index: 3;
	vertical-align: middle;
	horizontal-align: center;
	background-image: url( "s2r://panorama/images/icons/ui/vote_check.vsvg" );
	background-size: 50px 50px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	wash-color: #2bff00;
	opacity: 0.0;
	transform: scale3d( 2.0, 2.0, 1.0 );
	transition-property: transform, opacity;
	transition-duration: 0.2s;
	transition-timing-function: ease-out;
}

.MapTile.is-done .MapWinnerCheck
{
	opacity: 1.0;
	transform: scale3d( 1.0, 1.0, 1.0 );
}

.CreditBar
{
	width: 100%;
	height: 30px;
	background-color: #0b0f14f2;
	flow-children: none;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.CreditLabel
{
	width: fit-children;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	letter-spacing: 1px;
	color: #a3acb6;
	white-space: nowrap;
}

/* BEGIN mv-map-stock */

.mv-map-map_ar_baggage
{
	background-image: url("s2r://panorama/images/custom_game/mapvote/maps/map_ar_baggage.vtex");
}

.mv-map-map_ar_pool_day
{
	background-image: url("s2r://panorama/images/custom_game/mapvote/maps/map_ar_pool_day.vtex");
}

.mv-map-map_ar_shoots
{
	background-image: url("s2r://panorama/images/custom_game/mapvote/maps/map_ar_shoots.vtex");
}

.mv-map-map_ar_shoots_night
{
	background-image: url("s2r://panorama/images/custom_game/mapvote/maps/map_ar_shoots_night.vtex");
}

.mv-map-map_cs_italy
{
