.VotedStrip.vw-76 { width: 9576px; }
.VotedStrip.vw-77 { width: 9702px; }
.VotedStrip.vw-78 { width: 9828px; }
.VotedStrip.vw-79 { width: 9954px; }
.VotedStrip.vw-80 { width: 10080px; }
.VotedStrip.vw-81 { width: 10206px; }
.VotedStrip.vw-82 { width: 10332px; }
.VotedStrip.vw-83 { width: 10458px; }
