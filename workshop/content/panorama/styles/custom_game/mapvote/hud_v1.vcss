/* MapVote HUD - CS2 end-of-match vote (ruleset-safe).
   Contract: vote_v1.xml / VoteIds.cs  Palette: surface #12171ee8→#0b0f14f2, accent #ff9a1a
   Map image classes live in maps_v1.vcss (generated); this sheet is UI only.
   Deviation: background-position 50% 50% on .MapShot only - centers the 350×197 cover crop (§5.1). */

.HudScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

.VoteRoot
{
	width: 100%;
	height: 100%;
	flow-children: none;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.VoteRoot.is-fading
{
	opacity: 0.0;
	transition-duration: 0.5s;
	transition-timing-function: ease-in;
}

.VoteRoot.is-off
{
	visibility: collapse;
}

/* Browse (!maps): filter bar + catalog only. No current-map card and no voted strip. */
.VoteRoot.is-browse .VoteHeadRow
{
	visibility: collapse;
}

.VoteRoot.is-browse .MapVotes
{
	visibility: collapse;
}

.mv-glass
{
	width: 100%;
	height: 100%;
	background-color: #05090fb8;
	world-blur: gaussian( 3 );
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

/* One pass: top vignette plus a darker foot. Replaces two fullscreen gradients. */
.mv-scrim
{
	width: 100%;
	height: 100%;
	/* Top two stops stay readable over the victory splash; the body is darker than before. */
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000b8 ), color-stop( 0.22, #00000078 ), color-stop( 0.5, #0000008c ), color-stop( 0.78, #00000094 ), to( #000000c8 ) );
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.VoteColumn
{
	width: 100%;
	height: 100%;
	flow-children: down;
}

.VoteTopBar
{
	width: 100%;
	height: 50px;
	flow-children: none;
}

.VoteTitle
{
	/* Line box matches font-size so vertical-align: middle centers glyphs in the bar. */
	width: 100%;
	height: 22px;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 22;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #ffffff;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.MinimizeBtn
{
	width: fit-children;
	height: 28px;
	horizontal-align: right;
	vertical-align: middle;
	margin-right: 16px;
	padding-left: 12px;
	padding-right: 12px;
	background-color: #00000099;
	border: 1px solid #ffffff33;
	border-radius: 3px;
	flow-children: none;
	wash-color: none;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.MinimizeBtn:hover
{
	background-color: #ffffff22;
	brightness: 1.1;
	sound: "UIPanorama.generic_button_rollover";
}

.MinimizeBtn:active
{
	brightness: 0.85;
	sound: "UIPanorama.generic_button_press";
}

.MinimizeLabel
{
	width: fit-children;
	height: 15px;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 15;
	letter-spacing: 1.2px;
	text-transform: uppercase;
	color: #ffffff;
	white-space: nowrap;
}

/* Tuck: fade surfaces; keep scroll/flow trees mounted (repeat collapse crashes the layout). */
.VoteRoot.is-minimized .mv-glass,
.VoteRoot.is-minimized .mv-scrim,
.VoteRoot.is-minimized .VoteTitle,
.VoteRoot.is-minimized .CreditBar
{
	opacity: 0.0;
}

.VoteRoot.is-minimized .VoteBody,
.VoteRoot.is-minimized .VoteHeadRow,
.VoteRoot.is-minimized .MapGridHost
{
	height: 0px;
	padding-top: 0px;
	opacity: 0.0;
	overflow: clip;
}

.VoteRoot.is-minimized .MapTile,
.VoteRoot.is-minimized .FavBtn,
.VoteRoot.is-minimized .CurrentAction,
.VoteRoot.is-minimized .CurrentFavBtn,
.VoteRoot.is-minimized .CurrentRating,
.VoteRoot.is-minimized .FilterChip
{
	visibility: collapse;
}

.VoteRoot.is-minimized .MinimizeBtn
{
	background-color: #000000cc;
	border: 1px solid #ff9a1a;
}

.VoteRoot.is-minimized .MinimizeLabel
{
	color: #ff9a1a;
}

.VoteBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	padding-top: 12px;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.VoteHeadRow
{
	width: 100%;
	height: 213px;
	flow-children: right;
	padding-left: 8px;
	padding-right: 8px;
	margin-bottom: 8px;
}

.VotedSection
{
	width: fill-parent-flow( 1.0 );
	height: 213px;
	flow-children: down;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000a8 ), to( #00000070 ) );
	border: 1px solid #ffffff12;
	border-radius: 4px;
}

.VotedSection.has-votes
{
	border: 1px solid #3ddc8455;
}

.VotedRow
{
	width: 100%;
	height: 213px;
	overflow: scroll clip;
	flow-children: none;
	horizontal-align: center;
}

.VotedHint
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 32;
	color: #a3acb6;
	letter-spacing: 1px;
	text-transform: uppercase;
	z-index: 1;
}

.VotedHint.is-off
{
	visibility: collapse;
}

.VotedStrip
{
	height: 213px;
	flow-children: right;
	overflow: noclip noclip;
	horizontal-align: center;
	vertical-align: middle;
	/* Near-invisible fill so wheel hits gutters between tiles. */
	background-color: #00000001;
}

/* Slot pitch = 110px tile + 8px + 8px margin = 126px */
/* BEGIN vw-ladder */
.VotedStrip.vw-0 { width: 0px; }
.VotedStrip.vw-1 { width: 126px; }
.VotedStrip.vw-2 { width: 252px; }
.VotedStrip.vw-3 { width: 378px; }
.VotedStrip.vw-4 { width: 504px; }
.VotedStrip.vw-5 { width: 630px; }
.VotedStrip.vw-6 { width: 756px; }
.VotedStrip.vw-7 { width: 882px; }
.VotedStrip.vw-8 { width: 1008px; }
.VotedStrip.vw-9 { width: 1134px; }
.VotedStrip.vw-10 { width: 1260px; }
.VotedStrip.vw-11 { width: 1386px; }
.VotedStrip.vw-12 { width: 1512px; }
.VotedStrip.vw-13 { width: 1638px; }
.VotedStrip.vw-14 { width: 1764px; }
.VotedStrip.vw-15 { width: 1890px; }
.VotedStrip.vw-16 { width: 2016px; }
