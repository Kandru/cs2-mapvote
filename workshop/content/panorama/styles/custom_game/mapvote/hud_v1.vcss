/* MapVote HUD — CS2 end-of-match vote (ruleset-safe).
   Contract: vote.xml / VoteIds.cs  Palette: surface #12171ee8→#0b0f14f2, accent #ff9a1a
   Deviation: background-position 50% 50% on .MapShot only — centers the 343×193 cover crop (§5.1). */

.HudScreen
{
	width: 100%;
	height: 100%;
	z-index: 99999;
}

.VoteRoot
{
	width: 100%;
	height: 100%;
	flow-children: none;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

.VoteRoot.is-fading
{
	opacity: 0.0;
	transition-duration: 0.18s;
	transition-timing-function: ease-in;
}

.VoteRoot.is-off
{
	visibility: collapse;
}

.mv-glass
{
	width: 100%;
	height: 100%;
	background-color: #0000000d;
	world-blur: gaussian( 1 );
}

/* One pass: top vignette plus a darker foot. Replaces two fullscreen gradients. */
.mv-scrim
{
	width: 100%;
	height: 100%;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000e0 ), color-stop( 0.22, #0000008a ), color-stop( 0.5, #00000070 ), color-stop( 0.78, #00000078 ), to( #000000a0 ) );
}

.VoteColumn
{
	width: 100%;
	height: 100%;
	flow-children: down;
}

.VoteTopBar
{
	width: 100%;
	height: 40px;
	flow-children: none;
}

.VoteTitle
{
	/* No fixed height: Panorama paints label text at the top of the box, so a
	   28px box centered in this 40px bar sits the glyphs above the button. */
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 20;
	letter-spacing: 1.6px;
	text-transform: uppercase;
	color: #ffffff;
}

.MinimizeBtn
{
	width: 108px;
	height: 28px;
	horizontal-align: right;
	vertical-align: middle;
	margin-right: 16px;
	padding: 0px;
	background-color: #00000099;
	border: 1px solid #ffffff33;
	border-radius: 3px;
	flow-children: none;
	wash-color: none;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.MinimizeBtn:hover
{
	background-color: #ffffff22;
	brightness: 1.1;
	sound: "UIPanorama.generic_button_rollover";
}

.MinimizeBtn:active
{
	brightness: 0.85;
	sound: "UIPanorama.generic_button_press";
}

.MinimizeLabel
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 14;
	letter-spacing: 1.2px;
	text-transform: uppercase;
	color: #ffffff;
	white-space: nowrap;
}

.VoteRoot.is-minimized .mv-glass,
.VoteRoot.is-minimized .mv-scrim,
.VoteRoot.is-minimized .VoteBody,
.VoteRoot.is-minimized .VoteTitle,
.VoteRoot.is-minimized .CreditBar
{
	visibility: collapse;
}

.VoteRoot.is-minimized .MinimizeBtn
{
	background-color: #000000cc;
	border: 1px solid #ff9a1a;
}

.VoteRoot.is-minimized .MinimizeLabel
{
	color: #ff9a1a;
}

.VoteBody
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: down;
	padding-top: 12px;
}

.VotedSection
{
	width: 100%;
	flow-children: down;
	padding-top: 8px;
	padding-bottom: 12px;
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #000000b3 ), to( #00000066 ) );
	border-bottom: 1px solid #ffffff14;
}

.VotedSection.has-votes
{
	border-bottom: 2px solid #ff9a1a;
}

.VotedRow
{
	width: 100%;
	height: 213px;
	overflow: scroll clip;
	flow-children: none;
	horizontal-align: center;
}

.VotedHint
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 14;
	color: #a3acb6;
	letter-spacing: 1px;
	text-transform: uppercase;
	z-index: 1;
}

.VotedHint.is-off
{
	visibility: collapse;
}

.VotedStrip
{
	height: 213px;
	flow-children: right;
	overflow: noclip noclip;
	horizontal-align: center;
	vertical-align: middle;
}

/* Slot pitch = 110px tile + 8px + 8px margin = 126px */
/* BEGIN vw-ladder */
