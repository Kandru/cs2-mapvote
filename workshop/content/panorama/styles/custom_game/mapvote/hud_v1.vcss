	background-position: center center;
	background-repeat: no-repeat;
}

.mv-map-stock-cs_italy
{
	background-image: url("s2r://panorama/images/map_icons/screenshots/360p/cs_italy_png.vtex");
	background-size: 100% 100%;
	background-position: center center;
	background-repeat: no-repeat;
}

.mv-map-stock-cs_militia
{
	background-image: url("s2r://panorama/images/map_icons/screenshots/360p/cs_militia_png.vtex");
	background-size: 100% 100%;
	background-position: center center;
	background-repeat: no-repeat;
}

.mv-map-stock-cs_office
{
	background-image: url("s2r://panorama/images/map_icons/screenshots/360p/cs_office_png.vtex");
	background-size: 100% 100%;
	background-position: center center;
	background-repeat: no-repeat;
}

.mv-map-stock-cs_shelter
{
	background-image: url("s2r://panorama/images/map_icons/screenshots/360p/cs_shelter_png.vtex");
	background-size: 100% 100%;
	background-position: center center;
	background-repeat: no-repeat;
