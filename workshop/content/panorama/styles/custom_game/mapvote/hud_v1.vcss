.VotedStrip.vw-99 { width: 12474px; }
.VotedStrip.vw-100 { width: 12600px; }
/* END vw-ladder */

.CurrentMap
{
	width: 150px;
	height: 213px;
	margin-right: 8px;
	flow-children: none;
	background-color: #00000001;
}

.CurrentMap.is-off
{
	visibility: collapse;
}

.CurrentTag
{
	width: 110px;
	height: 16px;
	horizontal-align: left;
	vertical-align: top;
	margin-top: 2px;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 10;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #b8ffd6;
	background-color: #07120bc8;
	border: 1px solid #3ddc8466;
	border-radius: 2px;
	z-index: 4;
}

/* 110×193 shot, bottom-left; the header sits above it and actions to its right. */
.CurrentImage
{
	width: 110px;
	height: 193px;
	horizontal-align: left;
	vertical-align: bottom;
	flow-children: none;
	overflow: clip;
	background-color: #00000001;
	border: 1px solid #05070acc;
	border-radius: 3px;
}

.CurrentImage.is-fav
{
	border: 1px solid #3ddc84;
	box-shadow: #3ddc8444 0px 0px 5px 0px;
}

.CurrentRating
{
	width: 72px;
	height: 72px;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold;
	font-size: 38;
	letter-spacing: 0px;
	color: #eafff2;
	background-color: #05090fb8;
	border: 1px solid #3ddc8488;
	border-radius: 6px;
	z-index: 3;
}

.CurrentRating.is-positive
{
	color: #b8ffd6;
	border: 1px solid #3ddc84;
}

.CurrentRating.is-negative
{
	color: #ffb8b8;
	border: 1px solid #ff6b6b;
}

.CurrentFavBtn
{
	width: 24px;
	height: 24px;
	horizontal-align: right;
	vertical-align: top;
	margin-top: 4px;
	margin-right: 4px;
	z-index: 4;
	flow-children: none;
	wash-color: none;
	background-color: #000000aa;
	border: 1px solid #ffffff1f;
	border-radius: 3px;
	transition-property: background-color, brightness, border;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.CurrentFavBtn:hover
{
	background-color: #000000cc;
	brightness: 1.1;
	sound: "UIPanorama.generic_button_rollover";
}

.CurrentFavBtn:active
{
	brightness: 0.85;
	sound: "UIPanorama.generic_button_press";
}

.CurrentFavBtn.is-on
{
	border: 1px solid #3ddc84;
	background-color: #123a24cc;
}

/* Vertical action column to the right of the shot: like above dislike. */
.CurrentActions
{
	width: 36px;
	height: 193px;
	horizontal-align: right;
	vertical-align: bottom;
	flow-children: down;
	padding-top: 58px;
}

.CurrentAction
{
	width: 34px;
	height: 34px;
	horizontal-align: center;
	margin-bottom: 8px;
	flow-children: none;
	background-color: #000000b8;
	border: 1px solid #ffffff1f;
	border-radius: 3px;
	transition-property: background-color, brightness, border;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.CurrentActionIcon
{
	width: 20px;
	height: 20px;
	horizontal-align: center;
	vertical-align: middle;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	background-size: 20px 20px;
	wash-color: #ffffffcc;
	transition-property: wash-color;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.LikeBtn .CurrentActionIcon
{
	background-image: url( "s2r://panorama/images/icons/ui/check.svg" );
}

.DislikeBtn .CurrentActionIcon
{
	background-image: url( "s2r://panorama/images/icons/ui/cancel.svg" );
}

.CurrentAction:hover
{
	background-color: #ffffff1a;
	brightness: 1.1;
	sound: "UIPanorama.generic_button_rollover";
}

.CurrentAction:active
{
	brightness: 0.85;
	sound: "UIPanorama.generic_button_press";
}

.CurrentAction.is-on
{
	border: 1px solid #3ddc84;
	background-color: #123a24d8;
}

.CurrentAction.is-on .CurrentActionIcon
{
	wash-color: #59ffa0;
}

.DislikeBtn
{
	margin-bottom: 0px;
}

.FilterBar
{
	/* Hit-enabled (no hittest=false) + above MapGridHost so scrolled tiles cannot steal chip clicks. */
	width: fit-children;
	height: 36px;
	flow-children: right;
	horizontal-align: center;
	vertical-align: middle;
	padding-left: 12px;
	padding-right: 12px;
	margin-bottom: 4px;
	z-index: 5;
	/* Near-invisible fill so the bar itself receives hits between chips. */
	background-color: #00000001;
}

.FilterBar.is-off
{
	visibility: collapse;
}

.FilterTypeRow,
.FilterSortRow
{
	height: 36px;
	flow-children: right;
	vertical-align: middle;
}

.FilterSortRow
{
	margin-left: 16px;
}

.FilterChip
{
	width: fit-children;
	height: 28px;
	padding-left: 12px;
	padding-right: 12px;
	margin-right: 8px;
	vertical-align: middle;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
	flow-children: none;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
	wash-color: none;
}

.FilterChip.is-off
{
	visibility: collapse;
}

.FilterChip.is-disabled
{
	opacity: 0.35;
	cursor: default;
}

.FilterChip:not(.is-disabled):hover
{
	background-color: #ffffff1c;
	sound: "UIPanorama.generic_button_rollover";
}

.FilterChip:not(.is-disabled):active
{
	background-color: #ffffff2e;
	brightness: 0.9;
	sound: "UIPanorama.generic_button_press";
}

.FilterChip.is-disabled:hover,
.FilterChip.is-disabled:active
{
	background-color: #ffffff0d;
	brightness: 1.0;
	sound: "";
}

.FilterChip.is-active
{
	background-color: #ff9a1a22;
	border: 1px solid #ff9a1a;
}

.FilterChip.is-active:not(.is-disabled):hover
{
	background-color: #ff9a1a44;
}

.FilterChipLabel
{
	width: fit-children;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 15;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	white-space: nowrap;
}

.FilterChip.is-active .FilterChipLabel
{
	color: #ffd27a;
}

.MapGridHost
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: none;
	z-index: 1;
	overflow: clip;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.MapGrid
{
	width: 100%;
	height: 100%;
	overflow: clip;
	flow-children: down;
}

.MapEmpty
{
	width: 100%;
	height: 36px;
	horizontal-align: center;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #a3acb6;
	margin-top: 24px;
}

.MapEmpty.is-off
{
	visibility: collapse;
}

/* The catalog is the vertical scroller. Cards keep the voted-strip size and wrap by viewport width. */
.MapCatalog
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: right-wrap;
	overflow: squish scroll;
	horizontal-align: center;
	padding-left: 8px;
	padding-right: 8px;
	padding-top: 4px;
	padding-bottom: 12px;
	/* Near-invisible fill so wheel hits gutters between tiles. */
	background-color: #00000001;
}

.MapSlot
{
	width: 110px;
	height: 213px;
	horizontal-align: center;
	flow-children: none;
	margin: 4px 8px 4px 8px;
	/* Near-invisible fill so wheel hits gutters between tiles. */
	background-color: #00000001;
}

.MapSlot.is-off
{
	visibility: collapse;
}

.MapTile
{
	width: 100%;
	height: 193px;
	vertical-align: middle;
	border: 1px solid #05070acc;
	box-shadow: none;
	wash-color: none;
	overflow: clip;
	flow-children: none;
	transition-property: brightness, border, box-shadow, wash-color;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

/* Any map carrying a vote (not only the local player's) gets the green frame. */
.MapTile.is-voted
{
	border: 1px solid #3ddc84;
	box-shadow: #3ddc8455 0px 0px 5px 0px;
}

/* Favorited maps also read green, with a quieter glow than voted/self. */
.MapTile.is-fav
{
	border: 1px solid #3ddc84;
	box-shadow: #3ddc8444 0px 0px 5px 0px;
}

.MapTile.is-self
{
	border: 2px solid #59ffa0;
	box-shadow: #59ffa0cc 0px 0px 12px 2px;
	brightness: 1.12;
}

.MapTile.is-lost
{
	/* Greyed out, never blacked out. */
	wash-color: #8b95a3;
	brightness: 0.62;
	border: 1px solid #1a1f26;
	box-shadow: none;
	transition-property: wash-color, brightness, border, box-shadow;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.MapTile:hover
{
	sound: "UIPanorama.submenu_contents_rollover";
}

.MapTile:active
{
	sound: "UIPanorama.submenu_select";
}

.MapTile.is-lost:hover .MapShot
{
	transform: scale3d( 1.0, 1.0, 1.0 );
}

.MapShot
{
	width: 100%;
	height: 100%;
	z-index: 0;
	transform: scale3d( 1.0, 1.0, 1.0 );
	background-repeat: no-repeat;
	background-size: 350px 197px;
	background-position: 50% 50%;
	transition-property: transform;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

.MapTile:hover .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

.MapTile.is-self .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

.MapFade
{
	width: 100%;
	height: 100%;
	z-index: 1;
	/* Clear through mid-tile; shadow ramps below for vote count + name. */
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #00000000 ), color-stop( 0.5, #00000000 ), color-stop( 0.7, #000000aa ), to( #000000ff ) );
}

.MapVotes
{
	width: 100%;
	z-index: 2;
	vertical-align: bottom;
	horizontal-align: center;
	margin: 0px;
	margin-bottom: 40px;
	font-family: Stratum2;
	font-size: 29;
	color: #ff9a1a;
	text-align: center;
}

.MapName
{
	width: 90%;
	height: 36px;
	z-index: 2;
	margin: 0px 4px 6px 4px;
	vertical-align: bottom;
	horizontal-align: center;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	color: #ffffff;
	text-overflow: ellipsis;
	white-space: nowrap;
}

/* Aggregate net rating (likes − dislikes) in the tile's top-left corner. */
.MapRating
{
	width: 28px;
	height: 28px;
	horizontal-align: left;
	vertical-align: top;
	margin-top: 4px;
	margin-left: 4px;
	text-align: center;
	font-family: Stratum2 Bold;
	font-size: 15;
	font-weight: bold;
	letter-spacing: 0px;
	color: #c6d0da;
	background-color: #05090fc8;
	border: 1px solid #ffffff1f;
	border-radius: 3px;
	z-index: 3;
}

.MapRating.is-off
{
	visibility: collapse;
}

.MapRating.is-positive
{
	color: #b8ffd6;
	background-color: #07160dcc;
	border: 1px solid #3ddc8499;
}

.MapRating.is-negative
{
	color: #ffb8b8;
	background-color: #190909cc;
	border: 1px solid #ff6b6b99;
}

.FavBtn
{
	width: 28px;
	height: 28px;
	horizontal-align: right;
	vertical-align: top;
	/* MapTile is 193px centered in 213px MapSlot → 10px top gap; +4px inset. */
	margin-top: 14px;
	margin-right: 4px;
	/* Above MapTile / MapFade (z 0–3). */
	z-index: 4;
	flow-children: none;
	wash-color: none;
	background-color: #00000066;
	border-radius: 3px;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.FavBtn:hover
{
	background-color: #00000099;
	brightness: 1.1;
	sound: "UIPanorama.generic_button_rollover";
}

.FavBtn:active
{
	brightness: 0.85;
	sound: "UIPanorama.generic_button_press";
}

.FavIcon
{
	width: 20px;
	height: 20px;
	horizontal-align: center;
	vertical-align: middle;
	background-image: url( "s2r://panorama/images/icons/ui/favorite_no.vsvg" );
	background-size: 20px 20px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
}

.FavBtn.is-on .FavIcon
{
	background-image: url( "s2r://panorama/images/icons/ui/favorite_yes.vsvg" );
	wash-color: #59ffa0;
}

@keyframes 'mv-winner-glow'
{
	0%
	{
		border-color: #2bff74;
		box-shadow: #2bff7488 0px 0px 8px 0px;
		brightness: 1.0;
	}

	50%
	{
		border-color: #d9ffe9;
		box-shadow: #2bff74cc 0px 0px 20px 4px;
		brightness: 1.18;
	}

	100%
	{
		border-color: #2bff74;
		box-shadow: #2bff7488 0px 0px 8px 0px;
		brightness: 1.0;
	}
}

.MapTile.is-done
{
	wash-color: none;
	brightness: 1.0;
	border: 3px solid #2bff74;
	box-shadow: #2bff7499 0px 0px 12px 1px;
	animation-name: 'mv-winner-glow';
	animation-duration: 1.2s;
	animation-timing-function: ease-in-out;
	animation-iteration-count: infinite;
}

.MapTile.is-done .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

.MapWinnerCheck
{
	width: 50px;
	height: 50px;
	z-index: 3;
	vertical-align: middle;
	horizontal-align: center;
	background-image: url( "s2r://panorama/images/icons/ui/vote_check.vsvg" );
	background-size: 50px 50px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	wash-color: #2bff00;
	opacity: 0.0;
	transform: scale3d( 2.0, 2.0, 1.0 );
	transition-property: transform, opacity;
	transition-duration: 0.2s;
	transition-timing-function: ease-out;
}

.MapTile.is-done .MapWinnerCheck
{
	opacity: 1.0;
	transform: scale3d( 1.0, 1.0, 1.0 );
}

.CreditBar
{
	width: 100%;
	height: 30px;
	background-color: #0b0f14f2;
	flow-children: none;
	opacity: 1.0;
	transition-property: opacity;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.CreditLabel
{
	width: fit-children;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 18;
	letter-spacing: 1px;
	color: #a3acb6;
	white-space: nowrap;
}
