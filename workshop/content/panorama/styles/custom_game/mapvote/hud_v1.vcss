.FilterBar
{
	width: fit-children;
	height: 36px;
	flow-children: right;
	horizontal-align: center;
	vertical-align: middle;
	padding-left: 12px;
	padding-right: 12px;
	margin-bottom: 4px;
}

.FilterBar.is-off
{
	visibility: collapse;
}

.FilterTypeRow,
.FilterSortRow
{
	height: 36px;
	flow-children: right;
	vertical-align: middle;
}

.FilterSortRow
{
	margin-left: 16px;
}

.FilterChip
{
	height: 28px;
	min-width: 72px;
	padding-left: 12px;
	padding-right: 12px;
	margin-right: 8px;
	vertical-align: middle;
	background-color: #ffffff0d;
	border: 1px solid #ffffff14;
	border-radius: 3px;
	flow-children: none;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
	wash-color: none;
}

.FilterChip.is-off
{
	visibility: collapse;
}

.FilterChip.is-disabled
{
	opacity: 0.35;
	cursor: default;
}

.FilterChip:not(.is-disabled):hover
{
	background-color: #ffffff1c;
	sound: "UIPanorama.generic_button_rollover";
}

.FilterChip:not(.is-disabled):active
{
	background-color: #ffffff2e;
	brightness: 0.9;
	sound: "UIPanorama.generic_button_press";
}

.FilterChip.is-disabled:hover,
.FilterChip.is-disabled:active
{
	background-color: #ffffff0d;
	brightness: 1.0;
	sound: "";
}

.FilterChip.is-active
{
	background-color: #ff9a1a22;
	border: 1px solid #ff9a1a;
}

.FilterChip.is-active:not(.is-disabled):hover
{
	background-color: #ff9a1a44;
}

.FilterChipLabel
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 14;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #e8eef4;
	white-space: nowrap;
}

.FilterChip.is-active .FilterChipLabel
{
	color: #ffd27a;
}

.MapGridHost
{
	width: 100%;
	height: fill-parent-flow( 1.0 );
	flow-children: none;
}

.MapGrid
{
	width: 100%;
	height: 100%;
	overflow: squish scroll;
	flow-children: down;
}

.MapEmpty
{
	width: 100%;
	height: 36px;
	horizontal-align: center;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 16;
	letter-spacing: 1px;
	text-transform: uppercase;
	color: #a3acb6;
	margin-top: 24px;
}

.MapEmpty.is-off
{
	visibility: collapse;
}

.MapCatalog
{
	width: 100%;
	flow-children: down;
	overflow: noclip noclip;
	horizontal-align: center;
	padding-left: 12px;
	padding-right: 12px;
}

/* BEGIN rows-ladder */
.MapCatalog.rows-0 { height: 0px; }
.MapCatalog.rows-1 { height: 213px; }
.MapCatalog.rows-2 { height: 426px; }
.MapCatalog.rows-3 { height: 639px; }
.MapCatalog.rows-4 { height: 852px; }
.MapCatalog.rows-5 { height: 1065px; }
.MapCatalog.rows-6 { height: 1278px; }
.MapCatalog.rows-7 { height: 1491px; }
.MapCatalog.rows-8 { height: 1704px; }
.MapCatalog.rows-9 { height: 1917px; }
.MapCatalog.rows-10 { height: 2130px; }
/* END rows-ladder */

.CatalogRow
{
	width: 100%;
	height: 213px;
	flow-children: right;
	horizontal-align: center;
}

.CatalogRow.is-off
{
	visibility: collapse;
}

.MapSlot
{
	width: 110px;
	height: 213px;
	horizontal-align: center;
	flow-children: none;
	margin: 0px 8px 0px 8px;
}

.CatalogRow .MapSlot
{
	width: fill-parent-flow( 1.0 );
}

.MapSlot.is-off
{
	visibility: collapse;
}

.MapTile
{
	width: 100%;
	height: 193px;
	vertical-align: middle;
	border: 0px solid #00000000;
	box-shadow: none;
	wash-color: none;
	overflow: clip;
	flow-children: none;
	transition-property: brightness;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

.MapTile.is-self
{
	border: 2px solid #ffffff;
	box-shadow: #ffffff 0px 0px 6px 0px;
}

.MapTile.is-lost
{
	wash-color: #000000;
	brightness: 0.55;
	border: 0px solid #00000000;
	box-shadow: none;
	transition-property: wash-color, brightness;
	transition-duration: 0.5s;
	transition-timing-function: ease-out;
}

.MapTile:hover
{
	sound: "UIPanorama.submenu_contents_rollover";
}

.MapTile:active
{
	sound: "UIPanorama.submenu_select";
}

.MapTile.is-lost:hover .MapShot
{
	transform: scale3d( 1.0, 1.0, 1.0 );
}

.MapShot
{
	width: 100%;
	height: 100%;
	z-index: 0;
	transform: scale3d( 1.0, 1.0, 1.0 );
	background-repeat: no-repeat;
	background-size: 343px 193px;
	background-position: 50% 50%;
	transition-property: transform;
	transition-duration: 0.25s;
	transition-timing-function: ease-out;
}

.MapTile:hover .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

.MapTile.is-self .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

.MapFade
{
	width: 100%;
	height: 100%;
	z-index: 1;
	/* Clear through mid-tile; shadow ramps below for vote count + name. */
	background-color: gradient( linear, 0% 0%, 0% 100%, from( #00000000 ), color-stop( 0.5, #00000000 ), color-stop( 0.7, #000000aa ), to( #000000ff ) );
}

.MapVotes
{
	width: 100%;
	z-index: 2;
	vertical-align: bottom;
	horizontal-align: center;
	margin: 0px;
	margin-bottom: 40px;
	font-family: Stratum2;
	font-size: 26;
	color: #ff9a1a;
	text-align: center;
}

.MapName
{
	width: 90%;
	height: 36px;
	z-index: 2;
	margin: 0px 4px 6px 4px;
	vertical-align: bottom;
	horizontal-align: center;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 16;
	color: #ffffff;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.FavBtn
{
	width: 28px;
	height: 28px;
	horizontal-align: right;
	vertical-align: top;
	/* MapTile is 193px centered in 213px MapSlot → 10px top gap; +4px inset. */
	margin-top: 14px;
	margin-right: 4px;
	/* Above MapTile / MapFade (z 0–3). */
	z-index: 4;
	flow-children: none;
	wash-color: none;
	background-color: #00000066;
	border-radius: 3px;
	transition-property: background-color, brightness;
	transition-duration: 0.15s;
	transition-timing-function: ease-out;
}

.FavBtn:hover
{
	background-color: #00000099;
	brightness: 1.1;
	sound: "UIPanorama.generic_button_rollover";
}

.FavBtn:active
{
	brightness: 0.85;
	sound: "UIPanorama.generic_button_press";
}

.FavIcon
{
	width: 20px;
	height: 20px;
	horizontal-align: center;
	vertical-align: middle;
	background-image: url( "s2r://panorama/images/icons/ui/favorite_no.vsvg" );
	background-size: 20px 20px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
}

.FavBtn.is-on .FavIcon
{
	background-image: url( "s2r://panorama/images/icons/ui/favorite_yes.vsvg" );
}

@keyframes 'mv-winner-pulse'
{
	0%
	{
		border: 2px solid #ffffff00;
	}

	50%
	{
		border: 5px solid #ffff00;
	}

	100%
	{
		border: 2px solid #ffffff;
	}
}

.MapTile.is-done
{
	wash-color: none;
	brightness: 1.0;
	border: 2px solid #ffffff;
	box-shadow: #ffffff 0px 0px 6px 0px;
	animation-name: 'mv-winner-pulse';
	animation-duration: 0.5s;
	animation-timing-function: ease-out;
	animation-iteration-count: 1;
}

.MapTile.is-done .MapShot
{
	transform: scale3d( 1.2, 1.2, 1.0 );
}

.MapWinnerCheck
{
	width: 50px;
	height: 50px;
	z-index: 3;
	vertical-align: middle;
	horizontal-align: center;
	background-image: url( "s2r://panorama/images/icons/ui/vote_check.vsvg" );
	background-size: 50px 50px;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	wash-color: #2bff00;
	opacity: 0.0;
	transform: scale3d( 2.0, 2.0, 1.0 );
	transition-property: transform, opacity;
	transition-duration: 0.2s;
	transition-timing-function: ease-out;
}

.MapTile.is-done .MapWinnerCheck
{
	opacity: 1.0;
	transform: scale3d( 1.0, 1.0, 1.0 );
}

.CreditBar
{
	width: 100%;
	height: 30px;
	background-color: #0b0f14f2;
	flow-children: none;
}

.CreditLabel
{
	width: 100%;
	horizontal-align: center;
	vertical-align: middle;
	text-align: center;
	font-family: Stratum2 Bold Condensed;
	font-size: 16;
	letter-spacing: 1px;
	color: #a3acb6;
	white-space: nowrap;
}

/* BEGIN mv-map-stock */

.mv-map-stock-ar_baggage
{
	background-image: url("s2r://panorama/images/map_icons/screenshots/360p/ar_baggage_png.vtex");
	background-size: 100% 100%;
	background-position: center center;
	background-repeat: no-repeat;
}

